

#
# server info
#
server=127.0.0.1
port=5076
queue=default

updateport=5081
updatetype=tcp

#
# department setup
#
dept=WELCOME
marquee=Please wait for your number to be called.
serving=Currently Serving
showqueuesize=1
queuesize=Number Waiting
playlist=playlist.txt

#
# error handling
#
errormsg=Out of Service
showerrordetails=1

# -------------------------------
# TV layouts for Online Ordering:
# -------------------------------
#
# NOTE: This config file is not used to setup the TV layout for Online Ordering.
#       Instead the setup is retrieved from the Online Ordering database
#       on the blackbox, where the values from the 'settings' page are saved.

#
#  Layout 1:
#  +---------------------------------+
#  |             Marquee             |
#  +---------------------------------+
#  |                                 |
#  |            Region A             |
#  |                                 |
#  +----------------+----------------+
#  |                |                |
#  |    Region B    |    Region C    |
#  |                |                |
#  +----------------+----------------+
#
#  Layout 2:
#  +---------------------------------+
#  |             Marquee             |
#  +----------------+----------------+
#  |                |                |
#  |                |    Region B    |
#  |                |                |
#  |    Region A    +----------------+
#  |                |                |
#  |                |    Region C    |
#  |                |                |
#  +----------------+----------------+
#
#  Layout 3:
#  +---------------------------------+
#  |                                 |
#  |            Region A             |
#  |                                 |
#  +----------------+----------------+
#  |                |                |
#  |    Region B    |    Region C    |
#  |                |                |
#  +----------------+----------------+
#  |             Marquee             |
#  +---------------------------------+
#
#  Layout 4:
#  +----------------+----------------+
#  |                |                |
#  |    Region A    |    Region B    |
#  |                |                |
#  +----------------+----------------+
#  |                                 |
#  |            Region C             |
#  |                                 |
#  +---------------------------------+
#  |             Marquee             |
#  +---------------------------------+
#
#  Layout 5:
#  +--------+---------------+--------+
#  |        |               |        |
#  |        |               |        |
#  | Region |     Region    | Region |
#  |   A    |       B       |   C    |
#  |        |               |        |
#  |        |               |        |
#  |        |               |        |
#  +--------+---------------+--------+
#  |             Marquee             |
#  +---------------------------------+
#
#  Layout 6:
#  +----------------+----------------+
#  |    Marquee     |                |
#  +----------------+                |
#  |                |                |
#  |    Region A    |    Region B    |
#  |                |                |
#  |                |                |
#  |                |                |
#  |                |                |
#  |                |                |
#  +----------------+----------------+
#
#  Layout 7:
#  +---------------------------------+
#  |             Marquee             |
#  +---------------------------------|
#  |                                 |
#  |            Region A             |
#  |                                 |
#  |                                 |
#  |                                 |
#  |                                 |
#  |                                 |
#  +---------------------------------+
#
#  Layout 8:
#  +----------------------+----------+
#  |    Marquee           |          |
#  +----------------------+          |
#  |                      |          |
#  |    Region A          | Region B |
#  |                      |          |
#  |                      |          |
#  |                      |          |
#  |                      |          |
#  |                      |          |
#  +----------------------+----------+
#
#  Layout 9:
#  +---------------------------------+
#  |                                 |
#  |                                 |
#  |                                 |
#  |            Region A             |
#  |                                 |
#  |                                 |
#  |                                 |
#  |                                 |
#  |                                 |
#  +---------------------------------+
#
#
# The content of each region will be indicated by:
#   P = Playlist
#   W = Web page
#
# The 'layout' config entry is used to indicate the layout and the contents of each region of the layout:
#
# layout=Layout_number,Region_A,Region_B,Region_C
#
# For example, to indicate: layout 2,region A=Web
#                           region B=Web, region C=Playlist
#
# layout=2,W,W,P
#
# Or layout 3,region A=Web, region B=Web, region C=Web
#
# layout=3,W,W,W

#=====================

layout=1,W,P,W

#=====================

# For web pages, the URL needs to be specified. This will be indicated a config entry for
# region and its URL.  For example, the URL for region A would be indicated by:
#
# A-url=www.google.com
#
# If more than one region contains a web page, then there would be a config entry for each.
# For example of both region A and region C are a web page, then there would be config entries similar to this:
#
# A-url=www.google.com
# C-url=www.yahoo.com

#=====================

# For playlists, the name of the playlist file needs specified. This will be indicated a config entry for
# region and its playlist name.  For example, the playlist for region A would be indicated by:
#
# A-playlist=playlist.txt
#
# If more than one region contains aplaylist, then there would be a config entry for each.
# For example of both region A and region C are a playlist, then there would be config entries similar to this:
#
# A-playlist=playlist.txt
# C-playlist=myplaylist.txt


