       </font>
      </property>
      <property name="text">
       <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p align=&quot;center&quot;&gt;Depress power button on device while inserting two AAA batteries to power the device on.&lt;/p&gt;&lt;p align=&quot;center&quot;&gt;Hold on the power button until the &lt;span style=&quot; color:#cc0000;&quot;&gt;RED LED&lt;/span&gt; ring stops flashing and stays lit.&lt;/p&gt;&lt;p align=&quot;center&quot;&gt;Power button should now have a &lt;span style=&quot; color:#cc0000;&quot;&gt;RED LED &lt;/span&gt;&lt;span style=&quot; color:#000000;&quot;&gt;ring&lt;/span&gt; present as shown above.&lt;/p&gt;&lt;p align=&quot;center&quot;&gt;Connect the device to program via the programming cable.&lt;/p&gt;&lt;p align=&quot;center&quot;&gt;Press [SELECT PROGRAM FILE] button to select file on USB drive or local storage device.&lt;/p&gt;&lt;p align=&quot;center&quot;&gt;Press the [PROGRAM] button below to program the device.&lt;/p&gt;&lt;p align=&quot;center&quot;&gt;Wait until the &lt;span style=&quot; color:#cc0000;&quot;&gt;RED LED &lt;/span&gt;ring around the button is not present.&lt;/p&gt;&lt;p align=&quot;center&quot;&gt;Remove programming cable.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
      </property>
