@echo off
::
:: buildAll.cmd
:: Update HTe source and rebuild.
::
:: Copyright (c) 2013 Hobart Corporation. All Rights Reserved.
::
:: Note:
:: This script is intended to be run from the Windux\Application folder.
::
:: Prerequisites:
:: - Visual Studio 2010
:: - Qt Creator 3.3.0
:: - Qt Libraries 5.4.0 for Visual Studio 2010
:: - Tortoise SVN
::
:: Also need to have the "HobartApp" environment variable set.
::    e.g. HobartApp=C:\fasTrack\Windux\Application\

:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
:: Make sure the HobartApp environment variable is set correctly.
:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::

set HobartApp=%cd%
echo HobartApp environment variable (hard-coded) "%HobartApp%" is OK.

if DEFINED HobartApp (
    goto hobartAppIsSet
) ELSE (
    echo.
    echo HobartApp environment variable is NOT defined. It is required to build ScaleService.exe
    echo.
    goto done
)

:hobartAppIsSet

if EXIST %HobartApp% (
    echo.
    echo HobartApp environment variable "%HobartApp%" is OK.
    echo.
    goto checkQtVer
) ELSE (
    echo.
    echo HobartApp environment variable "%HobartApp%" is invalid.  Please correct.
    echo.
    goto done
)

:checkQtVer

:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
:: ENGDEV3 has a different version of Qt installed, so the
:: QTDIR and QTCREATOR environment variables may need to be
:: set differently than your own machine.
:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
if %COMPUTERNAME% == ENGDEV3 (
    :: Different directory path for ENGDEV3
    set QT_BASE_DIR=C:\Qt\Qt5.4.1
) else (
    set QT_BASE_DIR=C:\Qt\Qt5.4.0
)

if EXIST %QT_BASE_DIR% (
    echo.
    echo Qt Directory "%QT_BASE_DIR%" is OK.
    echo.
    goto continue
) ELSE (
    echo.
    echo Qt Directory "%QT_BASE_DIR%" does not exist.
    echo.
    goto done
)

:continue

set QTDIR=%QT_BASE_DIR%\5.4\msvc2010_opengl
set QTCREATOR=%QT_BASE_DIR%\Tools\QtCreator


set BUILDLOG=%TEMP%\build.log

::------------------------------------------
:: Set Subversion variables
set SVN_REPO=http://engdev1.itwfeg.biz/svn
set SVN_DIR_OS=fastrack-os-windows/branches/branch-1-htx-win/
set SVN_DIR_SCALEMANAGEMENT=fastrack-hte/branches/branch-1-htx-win/
set SVN_DIR_WINDUX=fastrack/branches/branch-1-htx-win/
set SVN_DIR_MULTIMEDIA=fastrack-multimedia/trunk/
::------------------------------------------

set WORKINGDIRECTORY=%cd%

:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
:: Used to build the RELEASE_TAG
:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::

set month=%DATE:~4,2%
set day=%DATE:~7,2%
set year=%DATE:~-4%
set hour=%TIME:~0,2%
set minute=%TIME:~3,2%
set seconds=%TIME:~6,2%

:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
:: NOTE:
:: Bump minor release as we go, do not bump this value unless you are building a release to be tested
:: Do not bump major, minor release number until ready for production or after production
:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::

set RELEASE_ID=2.5.701

set RELEASE_TAG=%RELEASE_ID%-%month%%day%%year%_%hour%%minute%%seconds%
:: Replace spaces with a zero (generated by single digit hour, minute, second)
set RELEASE_TAG=%RELEASE_TAG: =0%

::::::::::::::::::::::::::::::::::::::::::::::::::::::::
:: Generate SOFTWARE_VERSION_INFO file with release info
::::::::::::::::::::::::::::::::::::::::::::::::::::::::
:: Save release info to SOFTWARE_VERSION_INFO file
set tmpStr=Release ID: %RELEASE_ID%
echo %tmpStr%> %WORKINGDIRECTORY%\SOFTWARE_VERSION_INFO
set tmpStr=Creation Date: %month%/%day%/%year%
echo %tmpStr%>> %WORKINGDIRECTORY%\SOFTWARE_VERSION_INFO
set timeStr=%hour%:%minute%:%seconds%
:: Replace spaces with a zero (generated by single digit hour, minute, second)
set timeStr=%timeStr: =0%
set tmpStr=Creation Time: %timeStr%
echo %tmpStr%>> %WORKINGDIRECTORY%\SOFTWARE_VERSION_INFO

:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
:: Show Splashscreen
:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::

echo HTe Build Script
echo Copyright (c) 2013 Hobart Corporation. All Rights Reserved.
echo.
echo Building RELEASE_ID: %RELEASE_ID%,  RELEASE_TAG: %RELEASE_TAG%
echo.

echo.  > %BUILDLOG%
echo ============================================================  >> %BUILDLOG%
echo HTe Build Script  >> %BUILDLOG%
date /t  >> %BUILDLOG%
time /t  >> %BUILDLOG%
echo ============================================================  >> %BUILDLOG%
echo.  >> %BUILDLOG%

echo Building RELEASE_ID: %RELEASE_ID%,  RELEASE_TAG: %RELEASE_TAG% >> %BUILDLOG%
echo.  >> %BUILDLOG%

:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
:: Setup Environment
:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::

call "c:\Program Files (x86)\Microsoft Visual Studio 10.0\VC\vcvarsall.bat" x86  >> %BUILDLOG%

set PATH=%QTDIR%\bin;%QTCREATOR%\bin;%PATH%

echo Executing build script with path:
echo %PATH%
echo.

:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
:: Update source code from Subversion
:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
:updatesvn
echo --------------------
echo Updating source code
echo --------------------

echo Updating Os working copy from SVN
cd ..\..\Os
svn update --accept theirs-conflict

echo Updating ScaleManagement working copy from SVN
cd ..\ScaleManagement
svn update --accept theirs-conflict

echo Updating Windux working copy from SVN
cd ..\Windux
svn update --accept theirs-conflict

echo Updating Windux working copy from SVN
cd ..\Multimedia
svn update --accept theirs-conflict

cd %WORKINGDIRECTORY%

:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
:: Update build number in BuildNumber.cpp and version.ini
:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::

:: NEED TO COMMIT THESE UPDATES TO SVN???
python %WORKINGDIRECTORY%\shared\sessionHandler\python\updateBuildNumber.py  %WORKINGDIRECTORY%\source\app\BuildNumber.cpp  %RELEASE_TAG%

:: HTA-162
del %WORKINGDIRECTORY%\source\version.ini
svn update %WORKINGDIRECTORY%\source\version.ini

python %WORKINGDIRECTORY%\shared\sessionHandler\python\updateVersionINI.py  %WORKINGDIRECTORY%\source\version.ini  %RELEASE_ID%

:: HTA-162
svn commit %WORKINGDIRECTORY%\source\version.ini %WORKINGDIRECTORY%\source\app\BuildNumber.cpp -m "Build: Win32 %RELEASE_TAG%"

:: HTA-85: Set up version.ini with all our current firmware versions
python %WORKINGDIRECTORY%\shared\sessionHandler\python\updateFirmwareVersionINI.py  %WORKINGDIRECTORY%\source\version.ini  %WORKINGDIRECTORY%\prepack_firmware_bins

:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
:: Create baseline tag in Subversion
:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::

echo Creating baseline tag in SVN

svn copy %SVN_REPO%/%SVN_DIR_OS% %SVN_REPO%/fastrack-os-windows/tags/htx-%RELEASE_TAG% -m "Release htx-%RELEASE_TAG% - release tagged"
svn copy %SVN_REPO%/%SVN_DIR_SCALEMANAGEMENT% %SVN_REPO%/fastrack-hte/tags/htx-%RELEASE_TAG% -m "Release htx-%RELEASE_TAG% - release tagged"
svn copy %SVN_REPO%/%SVN_DIR_WINDUX% %SVN_REPO%/fastrack/tags/htx-%RELEASE_TAG% -m "Release htx-%RELEASE_TAG% - release tagged"
svn copy %SVN_REPO%/%SVN_DIR_MULTIMEDIA% %SVN_REPO%/fastrack-multimedia/tags/htx-%RELEASE_TAG% -m "Release htx-%RELEASE_TAG% - release tagged"

::::::::::::::::::::::::::::::::::
:: Remove any existing executables
::::::::::::::::::::::::::::::::::
if exist operatorInterface\scaleui\release\scaleui.exe                    del operatorInterface\scaleui\release\scaleui.exe
if exist operatorInterface\mb\release\mb.exe                              del operatorInterface\mb\release\mb.exe
if exist operatorInterface\scaleModelChoice\release\scaleModelChoice.exe  del operatorInterface\scaleModelChoice\release\scaleModelChoice.exe
if exist operatorInterface\videoPlayer\release\videoPlayer.exe            del operatorInterface\videoPlayer\release\videoPlayer.exe
if exist customerInterface\gcd\release\gcd.exe                            del customerInterface\gcd\release\gcd.exe
if exist HobartSigCertTool\release\sigcerttool.exe                        del HobartSigCertTool\release\sigcerttool.exe
if exist HobartSSHD\bin\Release\HobartSSHD.exe                            del HobartSSHD\bin\Release\HobartSSHD.exe
if exist Win32\Release\ScaleService.exe                                   del Win32\Release\ScaleService.exe
if exist Win32\Release\HobartHD.exe                                       del Win32\Release\HobartHD.exe
if exist shared\hobartWifi\hobartEAPUtility\Release\Hobart-EAPUtility.exe del shared\hobartWifi\hobartEAPUtility\Release\Hobart-EAPUtility.exe

:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
:: Build QT Projects
:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::

:buildscaleui
echo ----------------
echo Building scaleui
echo ----------------

cd operatorInterface
qmake scaleui.pro -r -spec win32-msvc2010 "CONFIG+=release"  >> %BUILDLOG%
jom.exe /S clean  >> %BUILDLOG%
jom.exe /S /J 4  >> %BUILDLOG%
cd ..

:buildgcd
echo ------------
echo Building gcd
echo ------------

cd customerInterface
qmake gcd.pro -r -spec win32-msvc2010 "CONFIG+=release"  >> %BUILDLOG%
jom.exe /S clean  >> %BUILDLOG%
jom.exe /S /J 4  >> %BUILDLOG%
cd ..

:buildmb
echo -----------
echo Building mb
echo -----------

cd operatorInterface\mb
qmake mb.pro -r -spec win32-msvc2010 "CONFIG+=release"  >> %BUILDLOG%
jom.exe clean  >> %BUILDLOG%
jom.exe /J 4  >> %BUILDLOG%
cd ..\..

:buildscalemodelchoice
echo -----------
echo Building scaleModelChoice
echo -----------

cd operatorInterface\scaleModelChoice
qmake mb.pro -r -spec win32-msvc2010 "CONFIG+=release"  >> %BUILDLOG%
jom.exe clean  >> %BUILDLOG%
jom.exe /J 4  >> %BUILDLOG%
cd ..\..

:buildvideoplayer
echo --------------------
echo Building videoPlayer
echo --------------------

cd operatorInterface
qmake videoPlayer.pro -r -spec win32-msvc2010 "CONFIG+=release"  >> %BUILDLOG%
jom.exe /S clean  >> %BUILDLOG%
jom.exe /S /J 4  >> %BUILDLOG%
cd ..

:buildsigcerttool
echo --------------------
echo Building sigcerttool
echo --------------------

cd HobartSigCertTool
qmake sigcerttool.pro -r -spec win32-msvc2010 "CONFIG+=release"  >> %BUILDLOG%
jom.exe /S clean  >> %BUILDLOG%
jom.exe /S /J 4  >> %BUILDLOG%
cd ..

:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
:: Build Visual Studio Projects
:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::

:buildaccesscounter
echo ----------------------
echo Building accesscounter
echo ----------------------

devenv accesscounter10.sln /clean "Release|Win32" /out %BUILDLOG% >> %BUILDLOG%
devenv accesscounter10.sln /build "Release|Win32" /out %BUILDLOG% >> %BUILDLOG%

echo ----------------------
echo     PEAP Utility
echo ----------------------
cd 
devenv shared\hobartWifi\hobartEAPUtility\Wlsample.sln /clean "Release|Win32" /out %BUILDLOG%  >> %BUILDLOG%
devenv shared\hobartWifi\hobartEAPUtility\Wlsample.sln /build "Release|Win32" /out %BUILDLOG%  >> %BUILDLOG%


::::::::::::::::::::::::::::::::::::::::::::::
:: Make sure all of the executables were built
::::::::::::::::::::::::::::::::::::::::::::::
if not exist operatorInterface\scaleui\release\scaleui.exe                    echo ERROR: scaleui.exe NOT BUILT
if not exist operatorInterface\mb\release\mb.exe                              echo ERROR: mb.exe NOT BUILT
if not exist operatorInterface\scaleModelChoice\release\scaleModelChoice.exe  echo ERROR: scaleModelChoice.exe NOT BUILT
if not exist operatorInterface\videoPlayer\release\videoPlayer.exe            echo ERROR: videoPlayer.exe NOT BUILT
if not exist customerInterface\gcd\release\gcd.exe                            echo ERROR: gcd.exe NOT BUILT
if not exist HobartSigCertTool\release\sigcerttool.exe                        echo ERROR: sigcerttool.exe NOT BUILT
if not exist HobartSSHD\bin\Release\HobartSSHD.exe                            echo ERROR: HobartSSHD.exe NOT BUILT
if not exist Win32\Release\ScaleService.exe                                   echo ERROR: ScaleService.exe NOT BUILT
if not exist Win32\Release\HobartHD.exe                                       echo ERROR: HobartHD.exe NOT BUILT
if not exist shared\hobartWifi\hobartEAPUtility\Release\Hobart-EAPUtility.exe echo ERROR: Hobart-EAPUtility.exe NOT BUILT

:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
:: End of Script
:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::

:done
echo Done!

echo ============================================================  >> %BUILDLOG%
echo Build Complete!  >> %BUILDLOG%
date /t  >> %BUILDLOG%
time /t  >> %BUILDLOG%

