	border-image: url(:/images/screens/SpinBoxButtonsOffTop.png) 0 0 0 0 stretch stretch;
background-color: transparent;
    
 }

 QTimeEdit#ntpTimeEdit::down-button {

 /* 16 + 2*1px border-width = 15px padding + 3px parent border */

