# used by the oper user account, since it is the account logged in when the scale application is running.
# requires the scale application to setup the config_os file.
[Desktop Entry]
Encoding=UTF-8
Version=1.0
Type=Application
Terminal=false
Name[en_US]=Hobart-Setup
Icon=/home/oper/setup tool icon_47x47.png
#Exec=/usr/bin/HobartSetup.exe
Exec=sudo /usr/bin/HobartSetup.exe
Name=Hobart-Setup
StartupNotify=true
