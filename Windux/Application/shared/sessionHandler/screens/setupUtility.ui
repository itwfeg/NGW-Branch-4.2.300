     <widget class="QPushButton" name="operatorDisplayIndicator">
      <property name="geometry">
       <rect>
        <x>628</x>
        <y>104</y>
        <width>12</width>
        <height>12</height>
       </rect>
      </property>
      <property name="sizePolicy">
       <sizepolicy hsizetype="Fixed" vsizetype="Fixed">
        <horstretch>12</horstretch>
        <verstretch>12</verstretch>
       </sizepolicy>
      </property>
      <property name="minimumSize">
       <size>
        <width>12</width>
        <height>12</height>
       </size>
      </property>
      <property name="maximumSize">
       <size>
        <width>12</width>
        <height>12</height>
       </size>
      </property>
      <property name="styleSheet">
       <string notr="true">QPushButton {
    /* Let's make the size of the button 1,5 times of font size. */
 /*   min-height: 1.5em;*/
    /* Font size just 1.*/
    /*font: 1em;*/
    /* Margins so that we get a little space on the left and right. */
    margin: 0 0 0 0;
    /* The font color */ 
    color: white;
    /* Here's the background gradient with start point, end point, 
       stop &quot;percentage&quot; and color, stop percentage and color. */
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                      stop: 0 #2198c0, stop: 1 #0d5ca6);
	border-image:url(:/images/screens/brightnessLED.png) 0 0 0 0 stretch stretch;

    /* We'll round the borders. */
    border-style: outset;
    /* Round radius will be 3px */
    border-radius: 5px;
    /* Border is only one pixel */
    border-width: 1px;
    /* Border color is now set */
    border-color: #0c457e;
}</string>
      </property>
      <property name="text">
       <string/>
      </property>
     </widget>
