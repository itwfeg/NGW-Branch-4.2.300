       <string notr="true">QPushButton#muteButton {
    /* Let's make the size of the button 1,5 times of font size. */
  /*  min-height: 1.5em;*/
    /* Font size just 1.*/
    /*font: 1em;*/
    /* Margins so that we get a little space on the left and right. */
    margin: 0 0 0 0;
    /* The font color */ 
 /*  color: white;*/
    /* Here's the background gradient with start point, end point, 
       stop &quot;percentage&quot; and color, stop percentage and color. */
 /*   background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                      stop: 0 #2198c0, stop: 1 #0d5ca6); */

	border-image:url(:/images/screens/volumeOffSmall.png) 0 0 0 0 stretch stretch;
    /* We'll round the borders. */
   /* border-style: outset;*/
    /* Round radius will be 3px */
    border-radius: 4px;
    /* Border is only one pixel */
   /* border-width: 1px; */
    /* Border color is now set */
   border: 1px solid gray;
/*background:transparent;*/
}

QPushButton#muteBut:checked {
	color: rgb(186, 217, 225); 

		border-image:url(:/images/screens/volumeOnSmall.png) 0 0 0 0 stretch stretch;
background:transparent;
}
</string>
