
#
# server info
#

confilefilename=hteapphookconfig.exe
allowkeyboard=1
allowclose=1
validateIpAddress=0

appname=HTe Server Config

#
# header setup
#
# style options:
# 0 = full task bar with logo
# 1 = compact task bar
# 2 = floating task bar in upper left corner
# 3 = floating task bar in upper middle
# 4 = floating task bar in upper right corner
# 5 = floating task bar with left offset
# 6 = floating task bar with right offset

#style=4
#logo=settings.png
#title=Online Ordering Settings
#background=#007DC6

style=0
logo=hobartLogo.png
title=HTe appHook Configuration
background=#404040

fontfamily=Arial
fontpointsize=18
fontcolor=#FFFFFF
