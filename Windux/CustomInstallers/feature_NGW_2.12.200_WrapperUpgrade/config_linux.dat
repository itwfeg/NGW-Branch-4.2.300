downloadDir=/usr/local/hobart/download
downloadFileSpecifiers=*.ht,*.hlx,*.dat,*.label_tagged,*.bin
# how often do we check for files in the download directory
downloadCheckingIntervalTimer=60  # in seconds
# once we see the first file appear in the download directory, we will wait
# this number of seconds to go looking to see if any more files showed up,
# or if any files have changed in size (they are still downloading)
downloadCheckingUpdateTimer=30     # in seconds
downloadProcessingDir=/usr/local/hobart/pending
downloadOutputDir=/usr/local/hobart/output

remoteScaleMaintenanceEnabled=F
remoteScaleMaintClrOutboxDays=0		# Number of days for files to sit in the outbox before removing them. If zero - don't remove.

keepCopyOfProcessedData=F
