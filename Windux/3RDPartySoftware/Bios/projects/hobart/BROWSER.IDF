#***    BROWSER.IDF Image Definition File for Embedded BIOS 5.3 HTML files.
#
#1.     Functional Description.
#       This file merges all the standard .HTML files displayed by the
#       the BIOS HTML browser into the main binary.
#
#2.     Modification history.
#       E. Khoruzhenko  05/06/04.       #5.3.3, new.
#
#3.     NOTICE: Copyright (C) 2005 General Software, Inc.

        CompressTo $(GSPROJ)\0.cmp      # compress HTML file.
        Load $(GSPROJ)\0.htm            # source for compression.

        ResName 0.htm                   # specify a resource name.
        LoadRes                         # load a resource into the BIOS image.
        BIOS16:RESOURCE_CLASS_HTML,     # the class is an HTML file.
        BIOS16:RESOURCE_ID_HTML_0,      # the ID is 1st browser file.
        1,                              # the binary IS data compressed.
        $(GSPROJ)\0.cmp                 # platform-specific HTML file (main).

#       CompressTo $(GSPROJ)\1.cmp      # compress HTML file.
