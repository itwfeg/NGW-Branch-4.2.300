# Debug Configuration parameters
# Format of commands is 'parameterName=parameterValue'
#
# Comments begin with '#'.  Everything after the comment indicators is ignored.
# Comments can be on their own line, or on the same line as a command.
#

#	NOTE: debugSetEnabled AND debugSetEnabledFile ARE MUTUALLY EXCLUSIVE !
# 
debugSetEnabled=T	# bool

# for Windows, to send debug to a file, use the following format
# debugSetEnabledFile=c:\\Hobart\\debug.out

# for Linux, to send debug to a file, use either of the following example locations
debugSetEnabledFile=/usr/local/hobart/debug.log
# debugSetEnabledFile=/etc/hobart/debug.log
# debugSetEnabledFile=/tmp/debug.log

