<logconfig>
	<logs>
		<log name="applog" type="file">
			<format>%date{MM/dd/yyyy hh:mm:ss.zzz} [%thread{%08x},%levelnum] %class{%-15.15s} %method{%-15.15s} %message\n</format>
			<filename>/tmp/scaleui.txt</filename>
			<rolloversize>10</rolloversize>
		</log>
		<log name="commlog" type="file">
			<format>%date{MM/dd/yyyy hh:mm:ss.zzz} %level{%-5.5s} %class{%-15.15s} %method{%-15.15s} %message\n</format>
			<filename>/tmp/scaleuiComm.txt</filename>
			<rolloversize>20</rolloversize>
		</log>
		<log name="creator" type="qt">
			<format>%date{hh:mm:ss.zzz} %class{%-15.15s} %method{%-15.15s} %message</format>
		</log>
		<log name="console" type="console">
			<format>%message</format>
		</log>
	</logs>
	<root>
		<level>INFO</level>
		<log-ref>applog</log-ref>
		<!--log-ref>creator</log-ref-->
	</root>
	<appenders>
		<appender name="Session">
			<level>DEBUG</level>
			<log-ref>commlog</log-ref>
			<!--log-ref>console</log-ref-->
		</appender>
	</appenders>
</logconfig>