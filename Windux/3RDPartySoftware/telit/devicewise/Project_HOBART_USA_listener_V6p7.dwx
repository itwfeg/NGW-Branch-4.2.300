  <Action type="LUA_INLINE" id="27">
   <Properties>
    <Property name="lua_text" value="&#13;&#10;function main()&#13;&#10;&#13;&#10;  local firm_type =   {&quot; APL &quot;, &quot; OPV &quot;,&quot; LDR &quot;,&quot; SMB &quot;,&quot; SCR &quot;,&quot; WNA1&quot;, &quot; WNA2 &quot;, &quot; WNA3 &quot;, &quot; WNA4 &quot;, &quot; WNA5 &quot;,   &#13;&#10;                       &quot; WND 1&quot;, &quot; WND2 &quot;, &quot; WND3 &quot;, &quot; WND4 &quot;, &quot; WND5 &quot;, &quot; WNB1 &quot;, &quot; WNB2&quot;, &quot; WNB3 &quot;, &quot; WNB4 &quot;,       &#13;&#10;                       &quot; WNB5 &quot;,&quot; WNC1 &quot;, &quot; WNC2 &quot;, &quot;WNC3 &quot;, &quot;WNC4 &quot;, &quot;WNC5 &quot;, &quot;WEIS &quot;, &quot; WEIH &quot;,&quot; WEIC &quot;,&quot; PRS1 &quot;,  &#13;&#10;                       &quot; PRH1 &quot;,&quot; PRC1 &quot;,&quot; PRS2&quot;,&quot; PRH2 &quot;,&quot; PRC2 &quot;,&quot; PRS3 &quot;,&quot; PRH3 &quot;,&quot; PRC3 &quot;,&quot; FPC &quot;, &quot; NVLD &quot;}               &#13;&#10;                                                                                &#13;&#10;  &#13;&#10;  local firmware_string_built = DWInput[&quot;firmware_string_built&quot;]&#13;&#10;  local firmware_version = DWInput[&quot;firmware_version&quot;]&#13;&#10;  local firmware_type = DWInput[&quot;firmware_type&quot;]&#13;&#10;&#13;&#10;  firmware_type = firmware_type + 1&#13;&#10;  if (firmware_type &gt; 38) then&#13;&#10;  firmware_type = 39&#13;&#10;  end&#13;&#10;&#13;&#10;&#13;&#10;  DWOutput[&quot;firmware_string_built&quot;] = firmware_string_built .. firm_type[firmware_type] .. firmware_version  .. &quot;,&quot; &#13;&#10; &#13;&#10;end &#13;&#10;&#13;&#10;main()&#13;&#10;"/>
    <Property name="variables_input" value="&lt;Variables&gt;&#10;      &lt;VariableInfo name=&quot;firmware_type&quot; options=&quot;7&quot; type=&quot;INT2&quot;/&gt;&#10;      &lt;VariableInfo desc=&quot;16&quot; length=&quot;32&quot; name=&quot;firmware_version&quot; options=&quot;7&quot; type=&quot;STRING&quot;/&gt;&#10;      &lt;VariableInfo length=&quot;600&quot; name=&quot;firmware_string_built&quot; options=&quot;7&quot; type=&quot;STRING&quot;/&gt;&#10;     &lt;/Variables&gt;"/>
    <Property name="variables_output" value="&lt;Variables&gt;&#10;      &lt;VariableInfo length=&quot;600&quot; name=&quot;firmware_string_built&quot; options=&quot;7&quot; type=&quot;STRING&quot;/&gt;&#10;     &lt;/Variables&gt;"/>
   </Properties>
   <InputMap>
    <LocalVariable logical_name="firmware_type" name="firmware_type"/>
    <LocalVariable logical_name="firmware_version" name="firmware_version"/>
    <LocalVariable logical_name="firmware_string_built" name="firmware_string_built"/>
   </InputMap>
   <OutputMap>
    <LocalVariable logical_name="firmware_string_built" name="firmware_string_built"/>
   </OutputMap>
   <Routes>
