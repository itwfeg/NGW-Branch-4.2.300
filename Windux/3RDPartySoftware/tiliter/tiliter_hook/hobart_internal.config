
# Tiliter Address (uncomment this to override db config)
HostAddress = 192.168.42.41
HostPort = 8000

# Endpoint URLs
ResultUrl = http://{device}:{port}/backend/result/
GetWeightUrl = http://{device}:{port}/backend/get_weight/
LabelLastResultUrl = http://{device}:{port}/backend/label_last_result/

# SSL Config
IgnoreAllSslErrors = 0
IgnoreSslHostNameMismatch = 0
IgnoreSslSelfSignedCert = 0

# Number of requests to save
NumberOfRequestsSaved = 50

# Request timeout time (in seconds)
RequestTimeout = 0

# Request number of retries
RequestNumRetries = 0

# How often to check network connection (in seconds)
ConnectionCheckInterval = 300

# Action Command Names
ResultAction = Predict
GetWeightAction = GetWeight
LabelLastResultAction = LabelLastResult

