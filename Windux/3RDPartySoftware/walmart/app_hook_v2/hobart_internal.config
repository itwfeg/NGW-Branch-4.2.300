
# Hobart Test Server
#InitUrl = http://hobart-ws.itwfeg.biz:8080/wmitem/services/hobartitemservice/UpdateConfigurationEvent/Hobart/invoke?initializeScaleFlg=true

# SE FPP Test App
#InitUrl = http://127.0.0.1:8081/UpdateConfiguration?initializeScaleFlg=true

# Walmart Production Environment
InitUrl = https://sms-event-controller.prod.us.walmart.net/UpdateConfigurationEvent/Hobart/invoke?initializeScaleFlg=True

# Walmart Dev environment
#InitUrl = https://sms-event-controller.dev.us.walmart.net/UpdateConfigurationEvent/Hobart/invoke?initializeScaleFlg=True

InitScaleVendor = HOBART
InitScaleModel = HOBART_HTI

# Legacy V1 Hook Single Item Lookup
# 0 = disabled
# 1 = use scale copy, if avail
# 2 = use scale copy, if avail and not expired
# 3 = always lookup, use server copy
# 4 = always lookup, use scale copy when offline
ServerLookupRule = 4
GetOneItemUrl = https://scale-data-provider-prod-svc.prod.us.walmart.net/scale/nutritionFact/plu/v2?plu={itemNumber}&countryCode={countryCode}&printerType=HOBART&storeNbr={storeNumber}

CacheExpirationTime = 144
CacheExpirationUnits = h

RemoveItemsFromCache = 0

ProductLookupTimeout = 2000
MinRelookupTime = 10000
TimeoutRetryInterval = 3

# Banner Code
BannerCode = A1

# Department Number; -1 to use scale dept no, 0 or higher to override
Department = -1

# MDM Location Model Division Number
# 1 = Walmart
# 18 = Sams
BusinessUnitType = 1

# SSL Config
IgnoreAllSslErrors = 0
IgnoreSslHostNameMismatch = 0
IgnoreSslSelfSignedCert = 0

# Number of requests to save
NumberOfRequestsSaved = 50

# How often to check network connection (in seconds)
ConnectionCheckInterval = 300

# Shutdown event dialog time (in seconds)
ShutdownEventDialogTime = 10

# Shutdown event maximum wait time (in seconds)
ShutdownEventMaxWaitTime = 60

# Request timeout time (in seconds)
RequestTimeout = 0

# Request number of retries
RequestNumRetries = 0

