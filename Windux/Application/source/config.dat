SQLInitialCommand0=PRAGMA journal_mode=WAL
# SOF-2210: Change 15-minute update to 1-hour; Turn off 15-minute update
SQLInitialCommand1=UPDATE Configs SET CoValue='1' where CoName='FTPhourlyUpdates' AND (SELECT count(*) FROM Configs WHERE CoName='FTP15MinuteUpdates' AND CoValue='1') = 1;
SQLInitialCommand2=UPDATE Configs SET CoValue='0' WHERE CoName='FTP15MinuteUpdates';

