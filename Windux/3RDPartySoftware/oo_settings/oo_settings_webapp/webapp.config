
#
# server info
#

confilefilename=webapp.exe
allowrefresh=0
allowcookies=1
allowkeyboard=1
allowclose=0
allowminimize=1
allowconfig=1

sendstorenumber=1
senddeptnumber=1
server=127.0.0.1
port=6000

appname=Settings

#
# header setup
#
# style options:
# 0 = full task bar with logo
# 1 = compact task bar
# 2 = floating task bar in upper left corner
# 3 = floating task bar in upper middle
# 4 = floating task bar in upper right corner
# 5 = floating task bar with left offset
# 6 = floating task bar with right offset

#style=0
#logo=settings.png
#title=Online Ordering Settings
#background=#007DC6

style=4
logo=settings.png
title=
background=#404040

fontfamily=Arial
fontpointsize=16
fontcolor=#FFFFFF

