      <enum>Qt::NoFocus</enum>
     </property>
     <property name="styleSheet">
      <string notr="true">QSpinBox#brightnessSpinBox{
	border-top-right-radius: 10px;
	border-bottom-right-radius: 10px;
	border: 2px solid black;
	height:252px;
	width: 98px;
	background:black;
	margin: 0 0 0 0;
}

 QSpinBox#brightnessSpinBox::up-button {
      width: 98px;
	height:126px;
 /* 16 + 2*1px border-width = 15px padding + 3px parent border */
	background:black;	
	background: url(:/images/SpinBoxButtonsOffTop.png);
    
 }
QSpinBox#brightnessSpinBox::down-button {
     width: 98px;
height:126px;
background:url(:/images/SpinBoxButtonsOffBottom.png);
    
}</string>
     </property>
