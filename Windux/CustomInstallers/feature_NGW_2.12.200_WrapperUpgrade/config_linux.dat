# Internal Configuration parameters - set by Hobart Only
#
# Format of commands is 'parameterName=parameterValue'
#
# Comments begin with '#'.  Everything after the comment indicators is ignored.
# Comments can be on their own line, or on the same line as a command.
#

# HLXLinuxLauncher expects the following line to one contiguous string, no space around the = sign, no comment at the end
scaleName=Hobart_HTi
scaleServiceName = Hobart Scale Service
webServiceName = GoWebs
appInstallerExe = appInstaller.exe

scaleServiceExe = ScaleService.exe
webServiceExe = srvany.exe
pathToLaunchUI = /home/Hobart/AccessScale/appLauncher.exe

systemGraphicsLocation=/usr/local/hobart/system/graphics
userGraphicsLocation=/usr/local/hobart/user/graphics
imagesLocation=/usr/local/hobart/images
systemUserRootDir=/usr/local/hobart
graphicsExtensions=.png                  # Can also be ".png,.gif,.bmp"
graphicFileSpecifiers=*.png,*.gif,*.jpg
noGraphicSelectedName=None
systemGraphicsTar=system.tar
userGraphicsTar=user.tar
productGraphicsTar=products.tar
productGraphicsDir=images/products/
systemProductGraphicsDir=images/system/products/
productGraphicsDefaultExtension=.jpg
categoryGraphicsTar=categories.tar
categoryGraphicsDir=images/categories/
systemCategoryGraphicsDir=images/system/categories/
categoryGraphicsDefaultExtension=.jpg
specialsGraphicsTar=specials.tar
specialsGraphicsDir=images/specials/
specialsGraphicsDefaultExtension=.gif
streamingGraphicsTar=slideshow.tar
streamingGraphicsDir=images/slideshow/
streamingGraphicsDefaultExtension=.jpg
softkeyGraphicsTar=softkeys.tar
softkeyGraphicsDir=images/softkeys/
softkeyGraphicsDefaultExtension=.gif
reservedSoftkeyGraphicsDir=/usr/local/hobart/system/flashkeygfx
selfServeGraphicsDir=images/selfServe/
systemSelfServeGraphicsDir=images/system/selfServe/
selfServeGraphicsDefaultExtension=.jpg
planogramGraphicsDir=images/planograms/
planogramGraphicsDefaultExtension=.jpg
videosDir=videos/
videosDefaultExtension=.mp4

# This file is in the systemUserRootDir dir
langFileName=/usr/local/hobart/lang

#
#
webPagesRootDir=/var
generalWebPageDirName=webPages
linuxWebPageDirName=www
languageFilesDir=/etc/hobart
pythonScriptsDir=python/

keyMountDir=/media/thumb

serviceLoginId=7776	  # HobRecordNum
serviceKeyRemoveTimeout=30		# in minutes
serviceKeyFile=service/key.dat
superKeyFile=supervisor/key.dat
selfServeKeyFile=selfserve/key.dat

directorySeparator=/
TemporaryDBDirectory=/etc/hobart/vmTmp/TempDBFiles
# Note: if you change the following line, you also have to update defaults.ini (the db config file)
dbLocation=/usr/local/hobart/db/scale/dbfiles
emptyDbLocation=/usr/local/hobart/db/scale/dbempty
dbDefaultsFile=/etc/hobart/defaults_linux.ini
# The following is cleared out for the LX scale, since we do not need to write the database from ram to compact flash.
dbBackupEnabled=F
dbBackupLocation=
dbMirrorLocation=/usr/local/hobart/db/scale/dbmirror
dbCheckBeforeShutdown=F
dbCheckIntegrity=T
dbCheckIntegrityFrequency=144  # the number of times per day to check for expired records (0 = never, 1 = at midnight, 2 = at midnight and noon, 24 = hourly on the hour, 48 = every half hour, 96 = every 15 minutes, 144 = every 10 minutes, 288 = every 5 minutes, 1440 = every minute)
dbCheckIndices=F
dbRebuildIndicesEnabled=T
versionIndependentBackupFile=/etc/hobart/verIndData
autoLoadVersionIndependentData=T
backupVersionIndependentDataNow=F
makeCopyOfVersionIndependentData=F

autoBackupDatabaseLocation=/usr/local/hobart/backup
autoBackupPLUDataFile=plu_data.ht
autoBackupFlashkeyDataFile=flashkey_data.ht
autoBackupLabelDataFile=label_data.ht
autoBackupOperatorDataFile=operator_data.ht
autoBackupStoreNameNumberFile=store_data.ht
autoBackupConfigFile=configuration_data.ht
autoBackupSynchConfigFile=synchronization_data.ht

SQLInitialCommand0=PRAGMA journal_mode=WAL

primaryConsoleSessionPriority=100
remoteConsoleSessionPriority=100
maxRemoteConsoleSessions=20
maxConsecutiveRTCMessages=10 # short
eventManagerEnabled=T
sessionManagerEnabled=T
sessionManagerStartupDelay=0   # in msec, 0=wait until initialized
sessionManagerPeriodicTimer=60 # in seconds
realTimeControllerEnabled=T
timerManagerEnabled=T
versionManagerEnabled=T
usbEnabledAtBootup=T
interruptXferTimeout=1000 #  defined in milliseconds
bulkXferTimeout=1000 #  defined in milliseconds
expiredRecordsCheckFrequency=24  # the number of times per day to check for expired records (0 = never, 1 = at midnight, 2 = at midnight and noon, 24 = hourly on the hour, 48 = every half hour, 96 = every 15 minutes, 1440 = every minute)

fakeWeigherManagerEnabled=F	# bool
fakeWeigherFrequency=600	# 60 = 1 per second, 30 = 2 per second, 15 = 4 per second, 120 = 1 per every 2 seconds, ...
fakeWeightStart=10000
fakeWeightIncrement=1250
# Weigher.h - WmHLX1=8, WmAWS=10, WmAWS2=12, 
fakeWeigherModel=8
# scaleFactors - 1, 2, 5
fakeWeigherScaleFactor=5
fakeWeigherMinWeightToPrint=5
# Avoir and Metric - 15kg weigher sf=5: 15045 * 20 = 300900
# Metric - 15kg weigher sf=2: 15018 * 20 = 300360
fakeWeigherMaxWeight=300900
# WeighMode_Avoir=1, WeighMode_Metric=0
fakeWeigherMode=1

fakePrinterManagerEnabled=F	# bool
fakeCLAManagerEnabled=F		# bool
fakeWrapperManagerEnabled=F	# bool
testBrowserEnabled=F		# bool
testBrowserMsgDelay=400		# int
testMessagesEnabled=F	#	False will disable access to 'Test Messages' in the menus

RFIDEnabled=F
RFIDDebounceTime=5   # in seconds
RFIDComPort=2
#RFIDHWPresent=

diagnosticsManagerEnabled=T
diagnosticsDB=/usr/local/hobart/db/diagnostics/diag.db
diagnosticsDBBackup=/usr/local/hobart/db/diagnostics/diag.db.backup
diagnosticsDBOld=/usr/local/hobart/db/diagnostics/diag.db.old

BarcodeScannerEnabled=T
BarcodeScannerComPort=4   #  set to the COM port that the driver installed the device on in your Control Panel System Devices

printerProbeTime=60       #  seconds to probe printer when no communications are present
weigherProbeTime=60       #  seconds to probe weigher when no communications are present
custDispProbeTime=60      # seconds to probe customer display (numeric and marquee)
labelApplierProbeTime=10  #  seconds to probe cla when no communications are present
wrapperProbeTime=4        #  seconds to probe wrapper when no communications are present

USBBulkDriveOnlyMode=T
USBBulkDriveName=d:                     # ***** WARNING: /dev/xxx ?
CompactFlashDriveName=/
PermanentRamDriveName=/ram0
TemporaryRamDriveName=/ram1
evolutionDirectory=/etc/hobart/
bootParametersFileName=bootParams.cfg
defaultNetworkConfigDir=defaultNetCfg
tmpNetworkConfigDir=tmpNetCfg
firmwareDirectory=/lib/firmware/hobart/
firmwareGenericFilename=source.bin
#The next parameter is a list of all firmware filenames that are stored in the permanent firmware directory noted above in 'firmwareDirectory', without directory path
#Additionally, three digits before the filename is the component's internal id number.
firmwareFilenames=045sourceFPC.bin 076sourceFPC2.bin

VersionManagerTempDir=/etc/hobart/vmTmp/
VersionManagerForceUpgrade=F
DefaultUpgradeFileName=evolution.ini
instalLogFile=/home/Hobart/AccessScale/install.log
VersionInfoFileName=version.ini
defaultUpgradeDirectory=/home/Hobart/AccessScale/upgrade
upgradeZipFile=Hobart.zip
upgradeIniFile=Hobart.ini

maxGraphicsPerProduct=4
productNameMaxLength=50
updatePrinterConfig=F	#  whether or not to update printer configuration on bootup
onlyPriLangForProdStats=T
# The number of implied decimal places for a percentage.
# i.e. if 3, 100% represented in memory as 1000, 10% in memory as 100
percentagePrecision=2  #short, the number of implied decimal places for a percentage
maxLifeDays=998		# Per Ultima code (CCD)
maxLifeHours=23
maxBonusPoints=9999
quarterPoundFor=25
halfPoundFor=50	
hundredGramsFor=100
continuousStatisticsDelay=15	# in seconds
lostPeripheralsCheckTime=30	# in seconds

keyboardNetWeightPrecision=2  # for turkey weigher

subtractDescent=F
maxLabelNumber=9999
labelFeedHeelFirst=1	   #  1 = HeelFirst or 0 = HeadFirst
testLabelType=2			#  0 = CheckerBoard, 1 = VerticalLines, 2 = HorizontalLines, 3 = HighPower
ignoreLabelFit=F
labelHorizontalOffset=0	#  dots from left hand edge of label
defaultNutriLabelTemplate=/etc/hobart/defaultNutriLabel.hlx
shelfLifeExpLabelFamily=9901
expirationLabelExpiredLimit=2  # number of days that a product is expired before the expiration label record is deleted automatically.

FBWFActivated=F
usingRestrictedLogins=F
# Following used by VersionManager in ScaleService, and appInstaller
appInstallerIsService=F
startupDelay=0
simulatePrinting=F          # for testing on laptop, when don't have a physical printer
monitorMemoryInterval=180   # for HLX, this is in minutes (default=30), for Fastrack this is in seconds (default=60)

dualRangeLimitAvoir=12000
dualRangeLimitMetric=6000
rezeroWeightLimitAvoir=600    # default to .600 lbs
rezeroWeightLimitMetric=300   # default to .300 kg

connectionIdentificationTimer=30     # in seconds
connectionIdentificationDelay=500    # in millisconds
commSessionReadMessageTimer=60       # in seconds
commSessionReadMessageDelay=200      # in milliseconds
waitBeforeConnectingTimer=5          # in seconds
waitBeforeConnectingDelay=1000       # milliseconds

pingConnectivityFrequency=0   # don't ping
pingConnectivityAttempts=1    # number of echo requests
offlinePingConnectivityFrequency=10  # in seconds
offlinePingConnectivityAttempts=4

synchronizationEnabled=T
synchronizeAllSecondariesTimer=90      # in seconds
notifyLocalBatchesTimer=90             # in seconds
recordsPerSyncIteration=5              # number of records
delayPerSyncIteration=100              # in milliseconds
maximumNumberRetries=3                 # up to 3 retries
retryCommandTimer=300                  # in seconds
hoursBeforeDeregistering=72            # in hours
delayPurgingBatches=100                # in milliseconds
hoursBeforeRemovingDeletedBatches=20   # in hours
recordsPerApplyIteration=10            # in records
delayPerApplyIteration=200             # in milliseconds
delayPerDeleteIteration=100            # in milliseconds
synchronizationStatusMessagesEnabled=F

useProductionPlanningDialog=T
httpRequestMethod=4                           # 1 = OPTIONS, 2 = GET, 3 = HEAD, 4 = POST, 5 = PUT, 6 = DELETE, 7 = TRACE, 8 = CONNECT
httpRequestContentType=application/json       # request content type for POST
httpWaitingDelay=1000                         # in ms
httpReadResponseTimer=300                     # 30 seconds
httpReadSomeResponseDelay=50                  # in milliseconds
httpReadNoResponseDelay=500                   # in milliseconds
httpMaxResponseLineLength=2048                # 2048 octets
httpReportErrors=F
httpQueryStore=store
httpQueryDept=dept
httpQueryModel=model
httpQueryPLU=plu
httpQueryWeight=weight
httpQueryQuantity=prod_qty
httpQueryLanguage=lang
httpUseOfflineSpool=T
httpOfflineSpoolRetry=30                      # in minutes
httpOfflineSpoolMaxRequestAge=14              # in days

expandedTextWidth=420
expandedTextHeight=420
expandedTextFontName=Hobart
expandedTextPointSize=5
