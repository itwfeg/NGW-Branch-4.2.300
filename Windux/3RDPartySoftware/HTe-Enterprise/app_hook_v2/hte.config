{
   "eventController": {
      "timerInterval": "0 */1 * * *",
      "events": {
         "changeConfiguration": true,
         "applyScaleSettings": false,
         "fetchPlu": false,
         "upgradeFirmware": true,
         "installFeature": true,
         "loadLabel": true,
         "captureMetrics": false
      }
   },
   "heartbeat": {
      "triggers": {
         "onInterval": true,
         "onStartup": true,
         "onShutdown": false,
         "onReconnect": true,
         "reconnectOffset": 0
      }
   },
   "offlineDialogs": {
      "messageFade": 5,
      "firstOfflineMessage": {
         "start": 120,
         "stop": 72,
         "frequency": 60
      },
      "secondOfflineMessage": {
         "start": 72,
         "stop": 24,
         "frequency": 30
      },
      "firstPrintingMessage": {
         "start": 144,
         "stop": 120
      },
      "secondPrintingMessage": {
         "start": 24,
         "stop": 0
      }
   }
}
