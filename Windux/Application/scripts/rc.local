#!/bin/sh
#
# rc.local
#
# This script is executed at the end of each multiuser runlevel.
# Make sure that the script will "exit 0" on success or any other
# value on error.
#
# In order to enable or disable this script just change the execution
# bits.
#
# By default this script does nothing. Modified it is used to start apps and cfg some system settings
# Modified FHA 10/20 2010 with optimizations
# Added disable write-back caching
hdparm -WO/dev/sda
# Set I/O Scheduler mode (mode := | deadline ?)
echo mode> /sys/block/sda/queue/scheduler
echo 1> /sys/block/sda/queue/iosched/fifo_batch

server_check()
{
	RUNNING=`netstat -anp | grep $1`

	while [ "" = "$RUNNING" ]
	do
		RUNNING=`netstat -anp | grep $1`
		echo -n "."
	done
}	

#/bin/mkdir /var/log/hobart

#start the touch screen controller
#echo "Starting the Touch Scren controller"
#/usr/bin/boot.tsharc start
#/home/bsquare/touch/Tsharc305BETA/boot.tsharc start


#start the web server
#echo "Starting goAhead Web Server"
#/usr/bin/webs &
#echo "Waiting on goAhead Web Server"
#server_check "webs"

#start the hobart application
#echo "Starting hobart application"
#/usr/bin/chobart_d &
#server_check "chobart_d"

xset dpms 0 0 0
exit 0
