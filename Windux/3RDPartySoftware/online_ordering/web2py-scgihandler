#!/bin/sh
# chkconfig: 2345 55 45
### BEGIN INIT INFO
# Provides:          web2py
# Required-Start:    $network
# Required-Stop:     $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Start web2py at boot time
# Description:       Start web2py scgihandler interface.
# X-Start-Before:    
# X-Stop-After:      
# X-Timesys-Start-Number:  55
# X-Timesys-Stop-Number:  45
### END INIT INFO

umask 022

stop_service() {
    printf "Stopping web2py scgihandler.py: "
    kill $(/usr/bin/ps ax | grep "scgihandler.py" | awk '{print $1}') 2>/dev/null
    # sometimes it doesn't quite die right away, or even after 1
    sleep 2
    printf "[ OK ]\n"
}

start_service() {
    printf "Starting web2py scgihandler.py: "

    count=`/usr/bin/ps ax | grep "scgihandler.py" | wc -l`
    if [ "$count" -gt "1" ]
    then
      printf "already running.\n"
      exit 0
    fi

    nohup python3 /var/www/web2py/scgihandler.py > /tmp/scgihandler.log 2>&1 &
    count=`/usr/bin/ps ax | grep "scgihandler.py" | wc -l`
    if [ "$count" -gt "1" ]
    then
      printf "[ OK ]\n"
    else
      printf "[ FAIL ]\n"
      exit 1
    fi
}

case $1 in

'start')
    start_service
    ;;

'stop')
    stop_service
    ;;

'restart')
    stop_service
    start_service
    ;;

*)
    echo "Usage: $0 [start|stop|restart]"
    ;;
esac
