     <property name="styleSheet">
      <string notr="true">QSpinBox{
	background-color:transparent;
	margin: 0 0 0 0;
}

 QSpinBox::up-button {
    /*width: 98px;
	height:126px;*/
 /* 16 + 2*1px border-width = 15px padding + 3px parent border */
	border-image: url(:/images/screens/SpinBoxButtonsOffTop.png) 0 0 0 0 stretch stretch;
	border-width: 0px;
    
 }
QSpinBox::down-button {
	/*width: 98px;	
	height:126px;*/
	border-image: url(:/images/screens/SpinBoxButtonsOffBottom.png) 0 0 0 0 stretch stretch;
    border-width: 0px;
}
</string>
     </property>
