//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON    DISCARDABLE     "res\\UnitTester.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_UNITTESTER_DIALOG DIALOGEX 0, 0, 374, 257
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Unit Test Administrative Dialog - UNICODE"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "&Output File:",IDC_STATIC,7,7,40,14,SS_CENTERIMAGE
    EDITTEXT        IDC_OUTPUT_FILE,55,7,220,14,ES_AUTOHSCROLL
    LTEXT           "&Tester:",IDC_STATIC,7,32,26,14,SS_CENTERIMAGE
    EDITTEXT        IDC_TESTER,55,32,139,14,ES_AUTOHSCROLL
    LTEXT           "Tested Software &Version:",IDC_STATIC,209,32,83,14,
                    SS_CENTERIMAGE
    EDITTEXT        IDC_VERSION,297,32,70,14,ES_AUTOHSCROLL
    LTEXT           "&Comments:",IDC_STATIC,7,49,59,11
    EDITTEXT        IDC_COMMENTS,7,61,360,46,ES_MULTILINE | ES_AUTOHSCROLL | 
                    ES_WANTRETURN | WS_VSCROLL,WS_EX_NOPARENTNOTIFY
    LTEXT           "&Available Tests:",IDC_STATIC,7,116,51,8
    LISTBOX         IDC_TESTS_LIST,7,130,174,99,LBS_NOINTEGRALHEIGHT | 
                    LBS_EXTENDEDSEL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "&Run Tests",IDRUNTESTS,125,236,50,14
    PUSHBUTTON      "&Finished",IDCANCEL,198,236,50,14
    EDITTEXT        IDC_SELECTED_TEST,193,116,174,14,ES_AUTOHSCROLL | 
                    ES_READONLY
    EDITTEXT        IDC_DESCRIPTION,193,130,174,99,ES_MULTILINE | 
                    ES_READONLY | ES_WANTRETURN | WS_VSCROLL
    DEFPUSHBUTTON   "Run &Continuous Tests",IDRUNLTTESTS,7,236,86,14
END


