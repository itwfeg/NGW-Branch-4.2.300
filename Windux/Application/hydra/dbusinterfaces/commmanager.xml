<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
        "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node name="/com/hobartcorp/commmanager">
    <interface name="com.hobartcorp.CommManager">
        <method name="open">
            <arg name="r" type="b" direction="out"/>
        </method>
        <method name="close"/>
        <method name="isOpen">
            <arg name="r" type="b" direction="out"/>
        </method>
        <method name="serverPort">
            <arg name="r" type="u" direction="out"/>
        </method>
        <method name="count">
            <arg name="r" type="u" direction="out"/>
        </method>
        <method name="terminateConnection">
            <arg name="name" type="s" direction="in"/>
        </method>
    </interface>
</node>
