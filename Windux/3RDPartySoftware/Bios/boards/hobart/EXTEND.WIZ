#**     EXTEND.WIZ - BIOStart extension file for Embedded BIOS 2000.
#
#1.     Functional Description.
#       This file describes all the design specific options invented for
#       this specific project to BIOStart.  It also defines a user
#       interface that BIOStart can use to guide the OEM through setting
#       design specific options.
#
#2.     Modification history.
#       K. C. Taylor    05/07/15.       #5.3.3, new.
#
#3.     NOTICE: Copyright (C) 2005 General Software, Inc.

##############################################################################
#                              SALSA EXTENSIONS                              #
##############################################################################

Symbol MENU_BOARD_SALSA "Configure AMD LXDB800 GX3/CS5535 ''Salsa'' Board."
  Type Menu
  Read OPTION_DEBUGAID_CPRINTF
  Read OPTION_DIAGNOSE_BOARD
  Read CONFIG_SETUP_CUSTOM_PCI_A
  Read CONFIG_SETUP_CUSTOM_PCI_B
  Read CONFIG_SETUP_CUSTOM_PCI_C
  Read CONFIG_SETUP_CUSTOM_PCI_D
  Read CONFIG_SETUP_CUSTOM_COM_1
  Read CONFIG_SETUP_CUSTOM_COM_2
  Read CONFIG_SETUP_CUSTOM_COM_3
  Read CONFIG_SETUP_CUSTOM_COM_4
  Read CONFIG_SETUP_CUSTOM_IRDA
  Read CONFIG_SETUP_CUSTOM_LPT_1
  Read CONFIG_SETUP_CUSTOM_VGADEF
  Read CONFIG_SETUP_CUSTOM_VGABUF
  Read CONFIG_SETUP_CUSTOM_VIDEO
  Read CONFIG_SETUP_CUSTOM_RFSH
  Read CONFIG_SETUP_CUSTOM_VWDTH
  Read CONFIG_SETUP_CUSTOM_PANEL
  Read CONFIG_SETUP_CUSTOM_LEGACY_USB
  Read OPTION_BOARD_PNP
  Read OPTION_BOARD_IRDA
  Read OPTION_BOARD_TFT
  Read OPTION_BOARD_CMOS_IDE80WIRE
  Read OPTION_BOARD_CMOS_SLEEPTYPE
  Read OPTION_BOARD_DISPLAY_BOOTTIME
  Read OPTION_BOARD_TEMPERATURE
  Read CONFIG_BOARD_PWR_LED_DUTY_RATE
  Read OPTION_SETUP_CUSTOM_SLEEPTYPE
  Read CONFIG_BOARD_S3_STACK_SIZE
  Read CONFIG_BOARD_S3_STACK_ADDRESS
  Read CONFIG_BOARD_VGA_BUFFER_ADDRESS
  Read CONFIG_BOARD_S3_CONTINUE_ENTRY_PT
  Read CONFIG_BOARD_SET_POWER_ENTRY_PT
  Read CONFIG_DIVIL_PIC_IRQM_LPC
  Read CONFIG_GX3_VGA_FB_SIZE
  Read CONFIG_TFT_REFR_RATE
  Read CONFIG_TFT_VSYNC_POL
  Read CONFIG_TFT_HSYNC_POL
  Read CONFIG_TFT_BUS_WIDTH
  Read CONFIG_TFT_FP_TYPE
  Help
    Note that these configuration values are only valid in the context of
    configuring the AMD LXDB800 GX3/CS5535 ``Salsa'' Board.

    Changes to these options are not directly supported by General Software
    as they are equivalent to direct design specific code changes.
  End Help
End Symbol

Symbol CONFIG_SETUP_CUSTOM_PCI_A "Custom Setup Default for PCI INT A Routing"
  Type Unsigned16
  Default 0
  Help
    0 = Auto.  Remaining values vary depending on IRQs available for assignment.
  End Help
End Symbol

Symbol CONFIG_SETUP_CUSTOM_PCI_B "Custom Setup Default for PCI INT B Routing"
  Type Unsigned16
  Default 0
  Help
    0 = Auto.  Remaining values vary depending on IRQs available for assignment.
  End Help
End Symbol

Symbol CONFIG_SETUP_CUSTOM_PCI_C "Custom Setup Default for PCI INT C Routing"
  Type Unsigned16
  Default 0
  Help
    0 = Auto.  Remaining values vary depending on IRQs available for assignment.
  End Help
End Symbol

Symbol CONFIG_SETUP_CUSTOM_PCI_D "Custom Setup Default for PCI INT D Routing"
  Type Unsigned16
  Default 0
  Help
    0 = Auto.  Remaining values vary depending on IRQs available for assignment.
  End Help
End Symbol

Symbol CONFIG_SETUP_CUSTOM_COM_1 "Custom Setup Default for UART Assigned COM 1"
  Type Unsigned16
  Default 1
  Help
    0 = Disable.  Remaining values vary depending on SIO parts detected.
  End Help
End Symbol

Symbol CONFIG_SETUP_CUSTOM_COM_2 "Custom Setup Default for UART Assigned COM 2"
  Type Unsigned16
  Default 0
  Help
    0 = Disable.  Remaining values vary depending on SIO parts detected.
  End Help
End Symbol

Symbol CONFIG_SETUP_CUSTOM_COM_3 "Custom Setup Default for UART Assigned COM 3"
  Type Unsigned16
  Default 0
  Help
    0 = Disable.  Remaining values vary depending on SIO parts detected.
  End Help
End Symbol

Symbol CONFIG_SETUP_CUSTOM_COM_4 "Custom Setup Default for UART Assigned COM 4"
  Type Unsigned16
  Default 0
  Help
    0 = Disable.  Remaining values vary depending on SIO parts detected.
  End Help
End Symbol

Symbol CONFIG_SETUP_CUSTOM_IRDA "Custom Setup Default for IRDA Control"
  Type Unsigned16
  Default 0
End Symbol

Symbol CONFIG_SETUP_CUSTOM_LPT_1 "Custom Setup Default for Parallel Port 1"
  Type Unsigned16
  Default 0
  Help
    0 = Disable.  Remaining values vary depending on SIO parts detected.
  End Help
End Symbol

Symbol CONFIG_SETUP_CUSTOM_VGADEF "Custom Setup Default for Default VGA Device"
  Type Unsigned16
  Default 1
  Help
    0 = None, 1 = Auto, 2 = GX3 VGA, 3 = PCI VGA card.
  End Help
End Symbol

Symbol CONFIG_SETUP_CUSTOM_VGABUF "Custom Setup Default for VGA Buffer Size"
  Type Unsigned16
  Default 4
  Help
    0 = Disabled, 1 = 2MB, 2 = 4MB, 3 = 8MB, 4 = 16MB, 5 = 32MB, 6 = 64MB.
  End Help
End Symbol

Symbol CONFIG_SETUP_CUSTOM_VIDEO "Custom Setup Default for Custom Video Mode"
  Type Unsigned16
  Default 0
End Symbol

Symbol CONFIG_SETUP_CUSTOM_RFSH "Custom Setup Default for Video Refresh Rate"
  Type Unsigned16
  Default 0
End Symbol

Symbol CONFIG_SETUP_CUSTOM_VWDTH "Custom Setup Default for Video Mode Width"
  Type Unsigned16
  Default 0
End Symbol

Symbol CONFIG_SETUP_CUSTOM_PANEL "Custom Setup Default for Video Panel Type"
  Type Unsigned16
  Default 2
End Symbol

Symbol CONFIG_SETUP_CUSTOM_LEGACY_USB "Custom Setup Default for Legacy USB"
  Type Unsigned16
  Default 1
End Symbol

Symbol OPTION_BOARD_PNP "Support Board Level PNP"
  Type Binary
  Default 1
End Symbol

Symbol OPTION_BOARD_IRDA "Support Board Level IRDA"
  Type Binary
  Default 1
End Symbol

Symbol OPTION_BOARD_TFT "Support Board Level TFT"
  Type Binary
  Default 1
End Symbol

Symbol OPTION_BOARD_CMOS_IDE80WIRE "Custom Setup Default for 80 Conductor Cable Detect"
  Type Unsigned16
  Default 0
  Help
    0 = 40 conductor cable, 1 = 80 conductor cable.
  End Help
End Symbol

Symbol OPTION_BOARD_CMOS_SLEEPTYPE "Custom Setup Default for ACPI Sleep Type"
  Type Unsigned16
  Default 0
End Symbol

Symbol OPTION_BOARD_DISPLAY_BOOTTIME "Display Boot Time Values in Board Module"
  Type Binary
  Default 0
  Help
    This option enables code that displays how long it took to reach various
    bench mark points in POST.  Note that a macro must be implemented in the
    project include file for this to work properly and that macro is not
    supported by BIOStart.
  End Help
End Symbol

Symbol CONFIG_BOARD_PWR_LED_DUTY_RATE "Power LED Duty/Rate Good Value"
  Type Hex32
  Default 03200190h
End Symbol

Symbol OPTION_SETUP_CUSTOM_SLEEPTYPE "Support Custom Setup Field for ACPI Sleep Type"
  Type Binary
  Default 0
End Symbol

Symbol CONFIG_BOARD_S3_STACK_SIZE "Stack Size for S3 Recovery"
  Type Hex16
  Default 1000h
  Help
    This parameter allows configuration of specific known values that
    are used as part of comunication with the GX3 driver while managing
    power.  It should not be changed without also changing the
    configuration of the GX3 driver.
  End Help
End Symbol

Symbol CONFIG_BOARD_S3_STACK_ADDRESS "Stack Address for S3 Recovery"
  Type Hex16
  Default 7000h
  Help
    This parameter allows configuration of specific known values that
    are used as part of comunication with the GX3 driver while managing
    power.  It should not be changed without also changing the
    configuration of the GX3 driver.
  End Help
End Symbol

Symbol CONFIG_BOARD_VGA_BUFFER_ADDRESS "VGA Buffer Address for S3"
  Type Hex32
  Default 040000h
  Help
    This parameter allows configuration of specific known values that
    are used as part of comunication with the GX3 driver while managing
    power.  It should not be changed without also changing the
    configuration of the GX3 driver.
  End Help
End Symbol

Symbol CONFIG_BOARD_S3_CONTINUE_ENTRY_PT "Known Entry Point for S3 Recovery"
  Type Hex32
  Default 0fe060h
  Help
    This parameter allows configuration of specific known values that
    are used as part of comunication with the GX3 driver while managing
    power.  It should not be changed without also changing the
    configuration of the GX3 driver.
  End Help
End Symbol
  
Symbol CONFIG_BOARD_SET_POWER_ENTRY_PT "Known Entry Point to Set S3 Power State"
  Type Hex32
  Default 0fe080h
  Help
    This parameter allows configuration of specific known values that
    are used as part of comunication with the GX3 driver while managing
    power.  It should not be changed without also changing the
    configuration of the GX3 driver.
  End Help
End Symbol

Symbol CONFIG_DIVIL_PIC_IRQM_LPC "IRQ bitmap for LPC Assignment"
  Type Binary16
  Default 0001000011011010b
End Symbol

Symbol CONFIG_GX3_VGA_FB_SIZE "Default VGA Frame Buffer Size (if no custom setup)"
  Type Unsigned16
  Default 8192
End Symbol

Symbol CONFIG_TFT_REFR_RATE "Flat Panel TFT Refresh Rate"
  Type Hex16
  Default 0A000h
End Symbol

Symbol CONFIG_TFT_VSYNC_POL "Flat Panel TFT VSYNC POL"
  Type Hex16
  Default 1000h
End Symbol

Symbol CONFIG_TFT_HSYNC_POL "Flat Panel TFT HSYNC POL"
  Type Hex16
  Default 0800h
End Symbol

Symbol CONFIG_TFT_BUS_WIDTH "Flat Panel TFT Bus Width"
  Type Hex16
  Default 00c0h
End Symbol

Symbol CONFIG_TFT_FP_TYPE "Flat Panel Type"
  Type Hex16
  Default 2
End Symbol
