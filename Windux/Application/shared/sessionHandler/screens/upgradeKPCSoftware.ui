    border-style: outset;
    border-radius: 10px;
    border-width: 2px;
    border-color: #ffffff;
}

QPushButton:pressed {
    margin: 0 0 0 0;
    color: black;
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,stop: 0 #ffffff, stop: 1 #d0d0d0);
    border-style: outset;
    border-radius: 10px;
    border-width: 2px;
    border-color: #000000;
}</string>
