#!/usr/bin/env xdg-open

[Desktop Entry]
Version=1.0
Encoding=UTF-8
Name=Touchscreen Calibration
Comment=Calibrate Touch Screen
Type=Application
TryExec=
#Exec=/usr/bin/hlincal
Exec=touchcal
Icon=/usr/share/pixmaps/gnome-spider.png
#StartupNotify=true
Terminal=true
Name[en]=Touchscreen Calibration
GenericName=Touchscreen Calibration

