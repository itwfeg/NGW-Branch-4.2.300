#! /bin/sh
#
# This is an init script for gatewayDiscovery

case "$1" in
  start)
    echo -n "Starting gatewayDiscovery"
    python /usr/local/hobart/python/gatewayDiscovery.py &
    ;;
  stop)
    echo -n "Stopping gatewayDiscovery"
    pkill -f gatewayDiscovery.py
    ;;
  restart)
    echo -n "Restarting gatewayDiscovery"
    pkill -f gatewayDiscovery.py
    python /usr/local/hobart/python/gatewayDiscovery.py &
    ;;
  *)
    echo "Usage: /etc/init.d/gatewayDiscovery {start|stop|restart}"
    exit 1
esac


