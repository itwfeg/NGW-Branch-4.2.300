   <property name="styleSheet">
    <string notr="true">QTabWidget#mainTab{
background:  transparent;
}
QTabWidget::pane{
	border-top: 1px solid rgb(180,180,180);
/*	border: 3px solid rgb(168,249,124); */
	border: 1px solid rgb(139,209,0);
	background:  url(images/carbonFiberBackground.png);
}

QTabWidget::tab-bar{
	left: 10px;
}

QTabBar::tab{
	border: 2px solid #C4C4C3;
    border-color: rgb(172, 199, 208);
	border-bottom-color: rgb(180,180,180);
	height: 50px; 
	min-width: 180px;
	background: rgb(227, 227, 227); 
/*background:rgb(168, 249, 124);*/
	border-top-left-radius: 8px;
    border-top-right-radius: 8px;

}
QTabBar::tab:selected{
   /* background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                 stop: 0 #020202, stop: 0.4 #080808,
                                 stop: 0.5 #121212, stop: 1.0 #181818); */
background:qlineargradient(spread:reflect, x1:0.005, y1:0, x2:1, y2:0, stop:0 rgba(40, 40, 40, 255), stop:1 rgba(66, 66, 66, 255));
	/*background:rgb(168, 249, 124);*/

	/*background: rgb(0, 51, 75); */
	border-color: rgb(139,209,0);
	color:rgb(139,209,0);
	/*color: rgb(172, 199, 208);*/
 
    margin-top: 2px;
	height: 48px;
  /* color: rgb(0,0,0);*/
/*
	border-color: rgb(0, 108, 158);
	border-color: rgb(171, 199, 216);
	background: rgb(78, 108, 124);
	color: rgb(255,255,255);
	border-bottom-color: rgb(180, 180, 180);
	border-bottom: 2px solid;
*/
}

QTabBar::tab:!selected{
   /* background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                 stop: 0 #020202, stop: 0.4 #080808,
                                 stop: 0.5 #121212, stop: 1.0 #181818); */
background:qlineargradient(spread:reflect, x1:0.005, y1:0, x2:1, y2:0, stop:0 rgba(40, 40, 40, 255), stop:1 rgba(66, 66, 66, 255));
	/*background:rgb(168, 249, 124);8/

	/*background: rgb(0, 51, 75); */
	border-color: rgb(139,209,0);
	color:rgb(255,255,255);
	/*color: rgb(172, 199, 208);*/
 
    margin-top: 2px;
	height: 48px;
  /* color: rgb(0,0,0);*/
}

QTabBar::tab:selected{
	margin-left: -10px;
	margin-right: -10px;
	border-bottom-color: rgb(180,180,180);
}
QTabBar::tab:first:selected{
	margin-left: 0px;
}

QTabBar::tab:last:selected{
	margin-right: 5px;
}

</string>
