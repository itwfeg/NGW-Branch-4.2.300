   <property name="styleSheet">
    <string notr="true">QTabWidget#mainTab{
/* whatever you want here */
}
QTabWidget::pane{
	border-top: 2px solid rgb(0,176,240);
	border: 3px solid rgb(0,176,240);
}

QTabWidget::tab-bar{
	alignment: center;
}

QTabBar::tab{
	border: 2px solid #C4C4C3;
    border-color: rgb(0, 176, 240);
	border-bottom-color: rgb(0,176,240);
	height: 50px; 
	/*min-width: 148px;*/
	background: rgb(227, 227, 227); 
	border-top-left-radius: 8px;
    border-top-right-radius: 8px;

}
QTabBar::tab:selected{
background:qlineargradient(spread:reflect, x1:0.005, y1:0, x2:1, y2:0, stop:0 rgba(40, 40, 40, 255), stop:1 rgba(66, 66, 66, 255));
	border-color: rgb(0,176,240);
	color:rgb(0,200,255);
	/*border-bottom-color: rgb(0,176,240);*/
	/*border-bottom-color: rgb(0,286,245);*/
	border-bottom-color: rgb(0, 255, 255);

    margin-top: 2px;
	height: 48px;
}

QTabBar::tab:!selected{
background:qlineargradient(spread:reflect, x1:0.005, y1:0, x2:1, y2:0, stop:0 rgba(40, 40, 40, 255), stop:1 rgba(66, 66, 66, 255));
	border-color: rgb(0,176,240);
	/*border-bottom-color: rgb(255,255,255);*/
	color:rgb(255,255,255); 
    margin-top: 2px;
	height: 48px;
}

QTabBar::tab:first:selected{
	margin-left: 0px;
}

QTabBar::tab:last:selected{
	margin-right: 0px;
}

