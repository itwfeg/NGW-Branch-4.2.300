
# Edgify Address (uncomment this to override db config)
HostAddress = 192.168.42.23
HostPort = 8090

# Endpoint URLs
PredictionUrl = http://{device}:{port}/api/v1/prediction
SetGroundTruthUrl = http://{device}:{port}/api/v1/predictions

# SSL Config
IgnoreAllSslErrors = 0
IgnoreSslHostNameMismatch = 0
IgnoreSslSelfSignedCert = 0

# Number of requests to save
NumberOfRequestsSaved = 50

# Request timeout time (in seconds)
RequestTimeout = 0

# Request number of retries
RequestNumRetries = 0

# UART Based Edgify Comms
CommEnabled = 1
CommDevice = /dev/ttyEdgify
#CommDevice = \\\\.\\COM4
CommBaudRate = 38400

# How often to check network connection (in seconds)
ConnectionCheckInterval = 300

# Action Command Names
ResultAction = Predict
ResetResultAction = ResetResult
LabelLastResultAction = LabelLastResult
ServerSettingsAction = ServerSettings

