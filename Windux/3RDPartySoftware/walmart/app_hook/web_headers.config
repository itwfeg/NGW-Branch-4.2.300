# Web Header configuration
Scale_Type = HOBART
WM_CONSUMER.ID = 33
WM_SVC.NAME = lookup-service
WM_SVC.VERSION = 1.0.0
WM_SVC.ENV = PROD

# Auth/Subscription Key
#Header1 = Ocp-Apim-Subscription-Key
#HeaderVal1 = 9bb0162bb7614c618163ec0ebf96cc1c

# Hobart Test Server
#WebServiceAddress = hobart-ws.itwfeg.biz:8080
#GetOneItem = wmitem/services/hobartitemservice/getOneItem
#GetAllItems = wmitem/services/hobartitemservice/getAllItem
#HealthCheck = wmitem/services/hobartitemservice/scalehealthcheck
#HttpsActive = 0

# Walmart Production Environment
WebServiceAddress = scale-data-provider-prod-svc.prod.us.walmart.net
GetOneItem = scale/nutritionFact/plu
GetAllItems = scale/nutritionFact/plus
HealthCheck = scale/nutritionFact/health
HttpsActive = 1

# Walmart CA
#WebServiceAddress = scales-orchestrator-intl.dev.scales-international.associateexperience.prod.us.walmart.net:8080
#NoQueryParams = 1
#GetOneItem = scale/scales/v1/{countryCode}/{bannerCode}/{storeNumber}/departments/{departmentId}/items/{itemNumber}
#GetAllItems = scale/scales/v1/{countryCode}/{bannerCode}/{storeNumber}/departments/{departmentId}/items
#HealthCheck = scale/v1/{countryCode}/{storeNumber}/{departmentId}/heartbeat
#HealthCheckFormat = CA
#HttpsActive = 0

# SSL Config
IgnoreAllSslErrors = 0
IgnoreSslHostNameMismatch = 0
IgnoreSslSelfSignedCert = 0

RemoveItemsFromCache = 0
NumberOfRequestsSaved = 50
# How often to check network connection (in seconds)
ConnectionCheckInterval = 300
# How often to perform health check (in minutes)
HealthCheckInterval = 0

# Banner Code
BannerCode = A1
# Department Number; -1 to use scale dept no, 0 or higher to override
Department = -1

CacheExpirationTime = 144
CacheExpirationUnits = h

TimeoutLength = 2000
AllItemsTimeoutLength = 30000
TimeoutRetryInterval = 3

OfflinePrintDialog.1.Start = 144
OfflinePrintDialog.1.End = 120
OfflinePrintDialog.2.Start = 24
OfflinePrintDialog.2.End = 0
OfflineVerifyDialog.1.Start = 120
OfflineVerifyDialog.1.End = 72
OfflineVerifyDialog.1.Frequency = 60
OfflineVerifyDialog.2.Start = 72
OfflineVerifyDialog.2.End = 24
OfflineVerifyDialog.2.Frequency = 30

# 0=serverDisabled, 1=useScaleCopyIfAvail, 2=useScaleCopyIfAvailAndNotExpired, 3=alwaysLookupOnServer, 4=alwaysLookupUseScaleCopyWhenOffline
ServerLookupRule = 3
MessageFadeTime = 5000

