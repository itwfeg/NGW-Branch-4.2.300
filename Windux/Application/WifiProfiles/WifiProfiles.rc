//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON                    "res\\WifiProfiles.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 235, 55
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About WifiProfiles"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "WifiProfiles Version 1.0",IDC_STATIC,40,10,119,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2009",IDC_STATIC,40,25,119,8
    DEFPUSHBUTTON   "OK",IDOK,178,7,50,16,WS_GROUP
END

IDD_WIFIPROFILES_DIALOG DIALOGEX 0, 0, 323, 228
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Wireless Profiles"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    PUSHBUTTON      "Exit",IDCANCEL,260,10,50,16
    GROUPBOX        "Restore Wifi Profile",IDC_RESTORE_PROF,10,40,300,80
    LTEXT           "Select A Restored File on your usb flash drive to restore from. Hold down ctrl key while clicking on profiles to restore.",IDC_RESTORE_PATH,20,50,200,20
    PUSHBUTTON      "Restore",IDC_BUTTON_RESTORE,250,50,50,14
    EDITTEXT        IDC_EDIT_RESTORED,20,70,280,40,ES_MULTILINE | ES_AUTOHSCROLL | ES_READONLY
    GROUPBOX        "Backup Wifi Profile",IDC_STATIC_BACKUP_PROF,10,130,300,90
    LTEXT           "Type in directory to backup profiles too.",IDC_BACKUP_PATH,20,140,200,10
    PUSHBUTTON      "Backup",IDC_BUTTON_BACKUP,250,150,50,14
    EDITTEXT        IDC_EDIT_BACKUP_PROFILES,20,150,220,12,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT_BACKED_UP,20,170,280,40,ES_MULTILINE | ES_AUTOHSCROLL | ES_READONLY
    CONTROL         130,IDC_STATIC,"Static",SS_BITMAP | SS_SUNKEN,10,10,80,22
END


