#define EP2_MAX_PACKET_SIZE 64
#define EP4_MAX_PACKET_SIZE 64
//#define BFRDATAOUT
//#define BFRHEADEROUT

PrinterCommManager::PrinterCommManager(RealTimeController *pRTC, USBPeripheralPowerUpManager *pPPUMan, USBD_NODE_ID nodeId) : HobThread((FUNCPTR) activeFunction, 	"tPrntComm", 100, 0, 8192, 20, 1024, MSG_Q_FIFO)
{
	this->pRTC = pRTC;
	this->nodeId = nodeId;
	pPPUM = pPPUMan;
	myPrinterType = FirstPrinter;

	if (pPPUM->pipeCreate(nodeId, 0x01, 1, 0, USB_XFRTYPE_INTERRUPT, USB_DIR_IN,
					  EP2_MAX_PACKET_SIZE, EP2_MAX_PACKET_SIZE, 10, &intInPipeHandle) != OK)
	{
		cout << "PrinterComm -- intIN Pipe Creation Failed" << endl;
	}

	if (pPPUM->pipeCreate(nodeId, 0x02, 1, 0, USB_XFRTYPE_INTERRUPT, USB_DIR_OUT,
					  EP2_MAX_PACKET_SIZE, EP2_MAX_PACKET_SIZE, 10, &intOutPipeHandle) != OK)
	{
		cout << "PrinterComm -- intOUT Pipe Creation Failed!" << endl;
	}

	if (pPPUM->pipeCreate(nodeId, 0x04, 1, 0, USB_XFRTYPE_BULK, USB_DIR_OUT,
					  EP4_MAX_PACKET_SIZE, EP4_MAX_PACKET_SIZE, 10, &bulkOutPipeHandle) != OK)
	{
		cout << "PrinterComm -- bulkOUT Pipe Creation Failed!" << endl;
	}


	pPPUM->setConfiguration(nodeId, 1, 0);

	pMyPrinterMgr = NULL;
	myDevicePhysicalAddress = 0;

	xmitting = false;

	pIrpBulkOut = NULL;
	pExtraBulkBfrListIN = NULL;
	numExtraBulkBufLists = 0;

	activeFunctionStart = true;
}

PrinterCommManager::~PrinterCommManager()
{
	if (pIrpBulkOut != NULL)
	{
		delete [] ((UINT8 *) pIrpBulkOut);
	}

	if (pMyPrinterMgr != NULL)
	{
		// delete my PrinterManager
		delete pMyPrinterMgr;
	}

	// delete my USB pipes
	pPPUM->pipeDestroy(intInPipeHandle);
	pPPUM->pipeDestroy(intOutPipeHandle);
	pPPUM->pipeDestroy(bulkOutPipeHandle);

	// I don't have to delete the IRPS because they fail when the device is detached!
}

int PrinterCommManager::activeFunction(void *pObject)
{
	return ((PrinterCommManager *) pObject)->activeFunctionTask();
}

int PrinterCommManager::activeFunctionTask()
{
	char recvBuffer[1024];
	int msgSize = 0;

	while (!activeFunctionStart)
	{
		taskDelay(10);
	}

	recvHeaderIrp();

	while (1)
	{
//		cout << "Printer USBEvolHeader::numMsgs = " << pThreadQ->numMsgs() << endl;
		if (!xmitting && pThreadQ->numMsgs() > 0)
		{
			msgSize = pThreadQ->receive(recvBuffer, sizeof(recvBuffer), WAIT_FOREVER);

			EvolMessage evolMessage(recvBuffer);

//					UINT16 dataLength = msgSize - evolMessage.getSerializedLength();

/*			evolHeader.setSourcePhysicalAddress(0x00);
			evolHeader.setSourceLogicalAddress(USBEvolHeader::USER_INTERFACE);

			evolHeader.setDestinationPhysicalAddress(myDevicePhysicalAddress); */

// Testing stuff
				evolHeader.setFunctionCode(CommHeader::LOW_SPEED_TRANSMIT);
				// This was used to fill in the logical address
//					commHdr.setSourcePhysicalAddress(ultimaAddrMap[evolMessage.getSourceObject()]);
				evolHeader.setSourcePhysicalAddress(0x00);
				evolHeader.setSourceLogicalAddress(CommHeader::USER_INTERFACE);
				evolHeader.setDestinationPhysicalAddress(myDevicePhysicalAddress);
//					commHdr.setSequence(messageNum++);
				evolHeader.setMessagePriority(0x09);
				evolHeader.setDestinationPriority(0x07);
				evolHeader.setAllocation(0x01);
				evolHeader.setResponse(0x01);
				evolHeader.setStatus(0x00);
				evolHeader.setBufferLength(sizeof(bfrDataOUT));
// End of testing stuff

			bool peripheralReply = false;

			switch (evolMessage.getDeviceType())
			{
				case Printer	 	:	peripheralReply = handlePrinterEvent((PrEvent) evolMessage.getEventType(), (const char *) &recvBuffer);
								 		break;
				case PrinterSystem	:	peripheralReply = handlePrinterSysEvent((SysEvent) evolMessage.getEventType(), (const char *) &recvBuffer);
								 		break;
				default			 	:
								 		break;
			}

			if (peripheralReply)
			{
				sendHeaderIrp();
			}
		}

		taskDelay(1);
	}

	return 0;
}

bool PrinterCommManager::handlePrinterEvent(PrEvent prEventType, const char *buffer)
{
	bool sendPeripheralMessage = false;

	switch (prEventType)
	{
		case PrWakeup:		cout << "PrinterComm -- PrWakeup!" << endl;
							{
								// Construct the Evol Message Buffer!!
								PrinterWakeup prWakeup(buffer);
								PrWakeupMsg prWakeupMsg;

								// fix up the message to be sent to the peripheral
								prWakeupMsg.prEvent = PrWakeup;
								prWakeupMsg.printerType = prWakeup.getPrinterType();
								prWakeupMsg.labelWidth = prWakeup.getLabelWidth();
								prWakeupMsg.bufferSize = prWakeup.getBufferSize();
								prWakeupMsg.printheadSize = prWakeup.getPrintheadSize();
								prWakeupMsg.prCfgStatus = prWakeup.getPrCfgStatus();

								evolHeader.setDestinationLogicalAddress(USBEvolHeader::PRINTER);
								evolHeader.setMessageLength(sizeof(prWakeupMsg));

								memcpy(&bfrDataOUT[0], (char *) &prWakeupMsg, sizeof(prWakeupMsg));

								sendPeripheralMessage = true;
							}
							break;
		case PrConfig:		cout << "PrinterComm -- PrConfig!" << endl;
							{
								PrinterConfiguration prConfig(buffer);
								PrConfigMsg prConfigMsg;

								prConfigMsg.prEvent = PrConfig;
								prConfigMsg.prConfigType = (PrConfigType) htons(prConfig.getConfigType());

								prConfig.getDeviceSignature((UINT8 *) &prConfigMsg.prConfiguration.deviceSignature);
								prConfigMsg.prConfiguration.printerType = prConfig.getPrinterType();
								prConfigMsg.prConfiguration.labelWidth = prConfig.getLabelWidth();
								prConfigMsg.prConfiguration.mediaSensorAdjustment = prConfig.getMediaSensorAdjustment();
								prConfigMsg.prConfiguration.outOfMediaCount = prConfig.getOutOfMediaCount();
								prConfigMsg.prConfiguration.printContrast = htons(prConfig.getPrintContrast());
								prConfigMsg.prConfiguration.configWord0 = htons(prConfig.getConfigWord0());			// Used on "European" labels
								prConfigMsg.prConfiguration.configWord1 = htons(prConfig.getConfigWord1());			// Used on "European" labels
								prConfigMsg.prConfiguration.configWord2 = htons(prConfig.getConfigWord2());		// Used on "European" labels
								prConfigMsg.prConfiguration.configWord3 = htons(prConfig.getConfigWord3());	// Used on "European" labels
								prConfigMsg.prConfiguration.configWord4 = htons(prConfig.getConfigWord4());
								prConfigMsg.prConfiguration.configWord5 = htons(prConfig.getConfigWord5());
								prConfigMsg.prConfiguration.configWord6 = htons(prConfig.getConfigWord6());
								prConfigMsg.prConfiguration.configWord7 = htons(prConfig.getConfigWord7());
								prConfigMsg.prConfiguration.configWord8 = htons(prConfig.getConfigWord8());
								prConfigMsg.prConfiguration.configWord9 = htons(prConfig.getConfigWord9());
								prConfigMsg.prConfiguration.configWord10 = htons(prConfig.getConfigWord10());
								prConfigMsg.prConfiguration.configWord11 = htons(prConfig.getConfigWord11());
								prConfigMsg.prConfiguration.configWord12 = htons(prConfig.getConfigWord12());
								prConfigMsg.prConfiguration.configWord13 = htons(prConfig.getConfigWord13());
								prConfigMsg.prConfiguration.mediaSensorType = (MediaSensorType) htons(prConfig.getMediaSensorType());
								prConfigMsg.prConfiguration.slaEjectLine = htons(prConfig.getSLAEjectLine());
								prConfigMsg.prConfiguration.printPosition = htons(prConfig.getPrintPosition());

								evolHeader.setDestinationLogicalAddress(USBEvolHeader::PRINTER);
								evolHeader.setMessageLength(sizeof(prConfigMsg));

								memcpy(&bfrDataOUT[0], (char *) &prConfigMsg, sizeof(prConfigMsg));

								sendPeripheralMessage = true;
							}
							break;
		case PrReset:		cout << "PrinterComm -- PrReset!" << endl;
							{
								PrGenericMsg genMsg;
								memset((char *) &genMsg, 0, sizeof(genMsg));

								genMsg.prEvent = PrReset;

								evolHeader.setDestinationLogicalAddress(USBEvolHeader::PRINTER);
								evolHeader.setMessageLength(sizeof(genMsg));

								memcpy(&bfrDataOUT[0], (char *) &genMsg, sizeof(genMsg));

								sendPeripheralMessage = true;
							}
							break;
		case PrEnable:		cout << "PrinterComm -- PrEnable!" << endl;
							{
								PrGenericMsg genMsg;
								memset((char *) &genMsg, 0, sizeof(genMsg));

								genMsg.prEvent = PrEnable;

								evolHeader.setDestinationLogicalAddress(USBEvolHeader::PRINTER);
								evolHeader.setMessageLength(sizeof(genMsg));

								memcpy(&bfrDataOUT[0], (char *) &genMsg, sizeof(genMsg));

								sendPeripheralMessage = true;
							}
							break;
		case PrDisable:		cout << "PrinterComm -- PrDisable!" << endl;
							{
								PrGenericMsg genMsg;
								memset((char *) &genMsg, 0, sizeof(genMsg));

								genMsg.prEvent = PrDisable;

								evolHeader.setDestinationLogicalAddress(USBEvolHeader::PRINTER);
								evolHeader.setMessageLength(sizeof(genMsg));

								memcpy(&bfrDataOUT[0], (char *) &genMsg, sizeof(genMsg));

								sendPeripheralMessage = true;
							}
							break;
		case PrMode:		cout << "PrinterComm -- PrMode!" << endl;
							{
								// Constuct the Evol Message Buffer!!
								PrinterMode prMode(buffer);
								PrModeMsg prModeMsg;

								prModeMsg.prEvent = PrMode;
								prModeMsg.mode = prMode.getPrinterMode();

								evolHeader.setDestinationLogicalAddress(USBEvolHeader::PRINTER);
								evolHeader.setMessageLength(sizeof(prModeMsg));

								memcpy(bfrDataOUT, (char *) &prModeMsg, sizeof(prModeMsg));

								sendPeripheralMessage = true;
							}
							break;
		case PrPrintheadPower:		cout << "PrinterComm -- PrPrintheadPower!" << endl;
							{
								// Constuct the Evol Message Buffer!!
								PrintheadPower printheadPower(buffer);
								PrPowerMsg prPowerMsg;

								prPowerMsg.prEvent = PrPrintheadPower;
								prPowerMsg.printheadPowerState = printheadPower.getPrintheadPowerState();

								evolHeader.setDestinationLogicalAddress(USBEvolHeader::PRINTER);
								evolHeader.setMessageLength(sizeof(prPowerMsg));

								memcpy(bfrDataOUT, (char *) &prPowerMsg, sizeof(prPowerMsg));

								sendPeripheralMessage = true;
							}
							break;
		case PrCommand:	cout << "PrinterComm -- PrCommand!" << endl;
						{
							// Constuct the Evol Message Buffer!!
							PrinterCommand printerCommand(buffer);
							PrCommandMsg prCommandMsg;

							prCommandMsg.prEvent = PrCommand;
							prCommandMsg.printerCommandType = printerCommand.getPrinterCommand();
							prCommandMsg.printerCommandOptions = printerCommand.getPrinterCommandOptions();
							prCommandMsg.printerIndirection = (PrinterIndirection) htons(printerCommand.getPrinterIndirection());
							prCommandMsg.value = htons(printerCommand.getValue());

							evolHeader.setDestinationLogicalAddress(USBEvolHeader::PRINTER);
							evolHeader.setMessageLength(sizeof(prCommandMsg));

							memcpy(bfrDataOUT, (char *) &prCommandMsg, sizeof(prCommandMsg));

							sendPeripheralMessage = true;
						}
						break;
		case PrCalibrate:	cout << "PrinterComm -- PrCalibrate!" << endl;
						{
							// Constuct the Evol Message Buffer!!
							PrinterCalibrate printerCalibrate(buffer);
							PrCalibrateMsg prCalibrateMsg;

							prCalibrateMsg.prEvent = PrCalibrate;
							prCalibrateMsg.printerCalibrateType = printerCalibrate.getPrinterCalibrateType();

							evolHeader.setDestinationLogicalAddress(USBEvolHeader::PRINTER);
							evolHeader.setMessageLength(sizeof(prCalibrateMsg));

							memcpy(bfrDataOUT, (char *) &prCalibrateMsg, sizeof(prCalibrateMsg));

							sendPeripheralMessage = true;
						}
						break;
		case PrRam:		cout << "PrinterComm -- PrRam!" << endl;
						{
							// Constuct the Evol Message Buffer!!
							PrinterRam printerRam(buffer);
							PrRamMsg prRamMsg;

							prRamMsg.prEvent = PrRam;

							for (int i = 0; i < PrNumRamLocations; i++)
							{
								prRamMsg.ram[i].location = (PrinterIndirection) htons(printerRam.getRamIndirection(i));
								prRamMsg.ram[i].value = htons(printerRam.getRamValue(i));
							}

							evolHeader.setDestinationLogicalAddress(USBEvolHeader::PRINTER);
							evolHeader.setMessageLength(sizeof(prRamMsg));

							memcpy(bfrDataOUT, (char *) &prRamMsg, sizeof(prRamMsg));

							sendPeripheralMessage = true;
						}
						break;
		case PrTest:	cout << "PrinterComm -- PrTest!" << endl;
						{
							// Constuct the Evol Message Buffer!!
							PrinterTest printerTest(buffer);
							PrTestMsg prTestMsg;

							prTestMsg.prEvent = PrTest;
							prTestMsg.data = printerTest.getData();

							evolHeader.setDestinationLogicalAddress(USBEvolHeader::PRINTER);
							evolHeader.setMessageLength(sizeof(prTestMsg));

							memcpy(bfrDataOUT, (char *) &prTestMsg, sizeof(prTestMsg));

							sendPeripheralMessage = true;
						}
						break;
		case PrNomSize:	cout << "PrinterComm -- PrNomSize!" << endl;
						{
							// Constuct the Evol Message Buffer!!
							PrinterSize printerSize(buffer);
							PrNomSizeMsg prNomSizeMsg;

							prNomSizeMsg.prEvent = PrNomSize;
							prNomSizeMsg.actualSize = htons(printerSize.getActualSize());
							prNomSizeMsg.measuredSize = htons(printerSize.getMeasuredSize());

							evolHeader.setDestinationLogicalAddress(USBEvolHeader::PRINTER);
							evolHeader.setMessageLength(sizeof(prNomSizeMsg));

							memcpy(bfrDataOUT, (char *) &prNomSizeMsg, sizeof(prNomSizeMsg));

							sendPeripheralMessage = true;
						}
						break;
		case PrMask:	cout << "PrinterComm -- PrMask!" << endl;
						{
							// Constuct the Evol Message Buffer!!
							PrinterMask printerMask(buffer);
							PrMaskMsg prMaskMsg;

							prMaskMsg.prEvent = PrMask;
							prMaskMsg.sensorMask = printerMask.getSensorMask();
							prMaskMsg.userMask = printerMask.getUserMask();

							evolHeader.setDestinationLogicalAddress(USBEvolHeader::PRINTER);
							evolHeader.setMessageLength(sizeof(prMaskMsg));

							memcpy(bfrDataOUT, (char *) &prMaskMsg, sizeof(prMaskMsg));

							sendPeripheralMessage = true;
						}
						break;
		case PrTeach:	cout << "PrinterComm -- PrTeach!" << endl;
						{
							// Constuct the Evol Message Buffer!!
							PrinterTeach printerTeach(buffer);
							PrTeachMsg prTeachMsg;

							CommandOperationList *pCOL = printerTeach.getCommandOperationList();

							memset((UINT8 *) &prTeachMsg.operation, (UINT8) 0xAA, sizeof(prTeachMsg.operation));

							prTeachMsg.prEvent = PrTeach;
							prTeachMsg.command = printerTeach.getPrinterCommandType();

							prTeachMsg.entries = htons(pCOL->getCommandBlock((CommandOperationMsg *) &(prTeachMsg.operation), true));

							evolHeader.setDestinationLogicalAddress(USBEvolHeader::PRINTER);
							evolHeader.setMessageLength(sizeof(prTeachMsg));

							memcpy(bfrDataOUT, (char *) &prTeachMsg, sizeof(prTeachMsg));

							sendPeripheralMessage = true;
						}
						break;
		case PrReqStatus:	cout << "PrinterComm -- PrReqStatus!" << endl;
							{
								PrGenericMsg genMsg;
								memset((char *) &genMsg, 0, sizeof(genMsg));

								genMsg.prEvent = PrStatus;

								evolHeader.setDestinationLogicalAddress(USBEvolHeader::PRINTER);
								evolHeader.setMessageLength(sizeof(genMsg));

								memcpy(&bfrDataOUT[0], (char *) &genMsg, sizeof(genMsg));

								sendPeripheralMessage = true;
							}
							break;
		case PrReqInquire:	cout << "PrinterComm -- PrReqInquire!" << endl;
							{
								PrGenericMsg genMsg;
								memset((char *) &genMsg, 0, sizeof(genMsg));

								genMsg.prEvent = PrInquire;

								evolHeader.setDestinationLogicalAddress(USBEvolHeader::PRINTER);
								evolHeader.setMessageLength(sizeof(genMsg));

								memcpy(&bfrDataOUT[0], (char *) &genMsg, sizeof(genMsg));

								sendPeripheralMessage = true;
							}
							break;
		case PrReqSensors:	cout << "PrinterComm -- PrReqSensors!" << endl;
							{
								PrGenericMsg genMsg;
								memset((char *) &genMsg, 0, sizeof(genMsg));

								genMsg.prEvent = PrSensors;

								evolHeader.setDestinationLogicalAddress(USBEvolHeader::PRINTER);
								evolHeader.setMessageLength(sizeof(genMsg));

								memcpy(&bfrDataOUT[0], (char *) &genMsg, sizeof(genMsg));

								sendPeripheralMessage = true;
							}
							break;
		case PrReqLabelTransfer:	cout << "PrinterComm -- PrReqLabelTransfer!" << endl;	
							{
								PrReqLabelTransferMsg requestMessage;
								memset((char *) &requestMessage, 0, sizeof(requestMessage));

								PrinterRequestLabelTransfer printerRequestLabelTransfer(buffer);

								requestMessage.prEvent = (PrEvent) 0x01; // COMM_REQUEST from Ultima World!!
								requestMessage.destination.physical.address = (USBEvolHeader::DeviceAddress) htons(myDevicePhysicalAddress);
								requestMessage.destination.logical.address = (USBEvolHeader::DeviceAddress) htons(USBEvolHeader::PRINTER);
								requestMessage.bufferSize = htons(printerRequestLabelTransfer.getDataLength());
								requestMessage.sequenceNumber = 0;

								evolHeader.setDestinationLogicalAddress(USBEvolHeader::COMM);
								evolHeader.setMessageLength(sizeof(requestMessage));

								memcpy(&bfrDataOUT[0], (char *) &requestMessage, sizeof(requestMessage));

								sendPeripheralMessage = true;
							}
							break;
		default		:
					break;
	}

	return sendPeripheralMessage;
}

bool PrinterCommManager::handlePrinterSysEvent(SysEvent sysEventType, const char *buffer)
{
	bool sendPeripheralMessage = false;

	switch (sysEventType)
	{
		case SysConfig:
						{
							cout << "PrinterComm -- PrinterSysConfig!" << endl;
							PrinterSystemConfiguration prSysConfig(buffer);

							SysConfigMsg sysConfigMsg;

							sysConfigMsg.function_code = SysConfig;
							sysConfigMsg.configType = (SysConfigType) htons(prSysConfig.getSysConfigType());
							prSysConfig.getDeviceSignature((UINT8 *) &sysConfigMsg.system_config.device_signature);
							sysConfigMsg.system_config.station_address = (DeviceAddress) htons(prSysConfig.getStationAddress());
							sysConfigMsg.system_config.controller_address = (DeviceAddress) htons(prSysConfig.getControllerAddress());

							evolHeader.setDestinationLogicalAddress(USBEvolHeader::SYSTEM);
							evolHeader.setMessageLength(sizeof(sysConfigMsg));

							memcpy(&bfrDataOUT[0], (char *) &sysConfigMsg, sizeof(sysConfigMsg));

							sendPeripheralMessage = true;
						}
						break;
		case SysReqStatus:
						{
							cout << "PrinterComm -- PrinterSysReqStatus!" << endl;
							SysGenericMsg genMsg;
							memset((char *) &genMsg, 0, sizeof(genMsg));

							genMsg.function_code = SysStatus;

							evolHeader.setDestinationLogicalAddress(USBEvolHeader::SYSTEM);
							evolHeader.setMessageLength(sizeof(genMsg));

							memcpy(&bfrDataOUT[0], (char *) &genMsg, sizeof(genMsg));

							sendPeripheralMessage = true;
						}
						break;
		case SysReqInquire:
						{
							cout << "PrinterComm -- PrinterSysReqInquire!" << endl;

							SysGenericMsg genMsg;
							memset((char *) &genMsg, 0, sizeof(genMsg));

							genMsg.function_code = SysInquire;

							evolHeader.setDestinationLogicalAddress(USBEvolHeader::SYSTEM);
							evolHeader.setMessageLength(sizeof(genMsg));

							memcpy(&bfrDataOUT[0], (char *) &genMsg, sizeof(genMsg));

							sendPeripheralMessage = true;
						}
						break;
		default				:
						{
							cout << "PrinterComm -- Some Other PrinterSys: !" << (UINT16) sysEventType << endl;
						}
						break;
	}

	return sendPeripheralMessage;
}

void PrinterCommManager::receivedPrinterMessage()
{
//	USBEvolHeader usbEvolHeader((char *) printerMess, true);
// Testing Stuff
	CommHeader usbEvolHeader((char *) printerMess, true);
// End of testing stuff

	UINT16 physicalAddress = usbEvolHeader.getSourcePhysicalAddress();
	UINT16 logicalAddress = usbEvolHeader.getSourceLogicalAddress();

	if (logicalAddress == USBEvolHeader::SYSTEM)
	{
//		receivedPrinterSysMessage((SysGenericMsg *) &printerMess[10], physicalAddress);
// Testing Stuff
		receivedPrinterSysMessage((SysGenericMsg *) &printerMess[19], physicalAddress);
// End of testing stuff
	}
	else
	{
//		receivedPrinterDevMessage((PrGenericMsg *) &printerMess[10], physicalAddress);
// Testing Stuff
		receivedPrinterDevMessage((PrGenericMsg *) &printerMess[19], physicalAddress);
// End of testing stuff
	}
}

void PrinterCommManager::receivedPrinterSysMessage(SysGenericMsg *genMsg, UINT16 peripheralAddress)
{
	switch (genMsg->function_code)
	{
		case SysStatus:	{
							cout << "USB Printer -- SysStatus!" << endl;

							SysStatusMsg *systemStatusMsg = (SysStatusMsg *) genMsg;

							SystemStatusInfo *pSystemStatus = new SystemStatusInfo((ntohs(systemStatusMsg->system_status.bit_error)),
																				   (ntohs(systemStatusMsg->system_status.address_error)),
																				   (ntohs(systemStatusMsg->system_status.rom_checksum)),
																				   (ntohl(systemStatusMsg->system_status.flags)),
																				    systemStatusMsg->system_status.partno,
																				   (ntohs(systemStatusMsg->system_status.system_checksum)),
																				   (ntohl(systemStatusMsg->system_status.init_flags)));

							if (pMyPrinterMgr == NULL)
							{
								PrinterSystemStatus pss(this, myPrinterType, pSystemStatus);

								const char *pPssMsg = pss.serialize();
								int mLength = pss.getSerializedLength();

								pMyPrinterMgr->send(pPssMsg, mLength);
							}

							delete pSystemStatus;
						}
						break;
		case SysInquire:{	
							cout << "USB Printer -- SysInquire: " << endl;

							SysInquireMsg *sysInquireMsg = (SysInquireMsg *) genMsg;

							if (pMyPrinterMgr == NULL)
							{
							 	PrinterSystemInquire psi(this, myPrinterType,
							 							 (SysConfigType) ntohs(sysInquireMsg->configType),
							 							 (UINT8 *) &sysInquireMsg->system_config.device_signature,
							 							 (DeviceAddress) ntohs(sysInquireMsg->system_config.station_address),
							 							 (DeviceAddress) ntohs(sysInquireMsg->system_config.controller_address));

								const char *pPsiMsg = psi.serialize();
								int mLength = psi.getSerializedLength();

								pMyPrinterMgr->send(pPsiMsg, mLength);
							}
						}
						break;
		default:		cout << "USB Printer -- Some Other System Type: " << (UINT16) genMsg->function_code << endl;
						break;
	}
}

void PrinterCommManager::receivedPrinterDevMessage(PrGenericMsg *genMsg, UINT16 peripheralAddress)
{
	switch (genMsg->prEvent)
	{
		case PrWakeup:	{	
							cout << "USB Printer -- PrWakeup: " << endl;
							cout << "************************************************" << endl;
							// Find out if this is first WakeUp Message
							if (pMyPrinterMgr == NULL)
							{
								// Create a new thread
								PrWakeupMsg *prWakeupMsg = (PrWakeupMsg *) genMsg;

								cout << "printerType: " << prWakeupMsg->printerType << endl;
								cout << "labelWidth: " << prWakeupMsg->labelWidth << endl;
								cout << "bufferSize: " << ntohs(prWakeupMsg->bufferSize) << endl;
								cout << "printheadSize: " << ntohs(prWakeupMsg->printheadSize) * 8 << endl;

								myPrinterType = prWakeupMsg->printerType;

								pMyPrinterMgr = pRTC->NewUSBPrinter(nodeId, this, 
																	prWakeupMsg->printerType,
																	prWakeupMsg->labelWidth,
																	ntohs(prWakeupMsg->bufferSize),
																	ntohs(prWakeupMsg->printheadSize) * 8);

								myDevicePhysicalAddress = peripheralAddress;

								// allocate USB_IRP and USB_BFR_LISTs

								numExtraBulkBufLists = prWakeupMsg->bufferSize / EP4_MAX_PACKET_SIZE;

								// subtract one because of USB_IRP contains one
								if (prWakeupMsg->bufferSize * EP4_MAX_PACKET_SIZE == numExtraBulkBufLists) 
								{
									numExtraBulkBufLists--;
								}

								UINT16 numBytes = sizeof(USB_IRP) + numExtraBulkBufLists * sizeof(USB_BFR_LIST);

								pIrpBulkOut = (USB_IRP *) (new UINT8[numBytes]);
								pExtraBulkBfrListIN = (USB_BFR_LIST *) ((UINT8 *) pIrpBulkOut + sizeof(USB_IRP));
							}
						} 
						break;
		case PrInquire:	{	
							cout << "USB Printer -- PrInquire: " << endl;
							PrInquireMsg *inquireMsg = (PrInquireMsg *) genMsg;

							if (pMyPrinterMgr != NULL)
							{
								PrinterInquire prInquire(this, myPrinterType); // use default constructor

								prInquire.setConfigType((PrConfigType) ntohs(inquireMsg->prConfigType));
								prInquire.setDeviceSignature(inquireMsg->prConfiguration.deviceSignature);
								prInquire.setPrinterType(inquireMsg->prConfiguration.printerType);
								prInquire.setLabelWidth(inquireMsg->prConfiguration.labelWidth);
								prInquire.setMediaSensorAdjustment(inquireMsg->prConfiguration.mediaSensorAdjustment);
								prInquire.setOutOfMediaCount(inquireMsg->prConfiguration.outOfMediaCount);		// Immutable!! Set to 200 on Ultima
								prInquire.setPrintContrast(ntohs(inquireMsg->prConfiguration.printContrast));	// "Print Contrast" on Ultima Configuration.
								prInquire.setConfigWord0(ntohs(inquireMsg->prConfiguration.configWord0));				// Used on "European" labels
								prInquire.setConfigWord1(ntohs(inquireMsg->prConfiguration.configWord1));			// Used on "European" labels
								prInquire.setConfigWord2(ntohs(inquireMsg->prConfiguration.configWord2));		// Used on "European" labels
								prInquire.setConfigWord3(ntohs(inquireMsg->prConfiguration.configWord3));	// "Expel Position" on Ultima Configuration.
								prInquire.setConfigWord4(ntohs(inquireMsg->prConfiguration.configWord4));			// Used on "European" labels
								prInquire.setConfigWord5(ntohs(inquireMsg->prConfiguration.configWord5));
								prInquire.setConfigWord6(ntohs(inquireMsg->prConfiguration.configWord6));
								prInquire.setConfigWord7(ntohs(inquireMsg->prConfiguration.configWord7));
								prInquire.setConfigWord8(ntohs(inquireMsg->prConfiguration.configWord8));
								prInquire.setConfigWord9(ntohs(inquireMsg->prConfiguration.configWord9));
								prInquire.setConfigWord10(ntohs(inquireMsg->prConfiguration.configWord10));
								prInquire.setConfigWord11(ntohs(inquireMsg->prConfiguration.configWord11));
								prInquire.setConfigWord12(ntohs(inquireMsg->prConfiguration.configWord12));
								prInquire.setConfigWord13(ntohs(inquireMsg->prConfiguration.configWord13));
								prInquire.setMediaSensorType(inquireMsg->prConfiguration.mediaSensorType);
								prInquire.setSLAEjectLine(ntohs(inquireMsg->prConfiguration.slaEjectLine));
								prInquire.setPrintPosition(ntohs(inquireMsg->prConfiguration.printPosition));

								const char *pWiMsg = prInquire.serialize();
								int mLength = prInquire.getSerializedLength();

								pMyPrinterMgr->send(pWiMsg, mLength);
							}
						}
						break;
		case PrStatus:	{
							cout << "USB Printer -- PrStatus: " << endl;
							PrStatusMsg *statusMsg = (PrStatusMsg *) genMsg;

							if (pMyPrinterMgr != NULL)
							{
								PrinterStatus ps(this, myPrinterType); // use default constructor

								ps.setState(statusMsg->state);
								ps.setCommand(statusMsg->command);
								ps.setError(statusMsg->error);
								ps.setHistory(statusMsg->history);
								ps.setSensor(statusMsg->sensor);
								ps.setUser(statusMsg->user);
								ps.setCounter(ntohs(statusMsg->counter));
								ps.setSensorMask(statusMsg->sensorMask);
								ps.setUserMask(statusMsg->userMask);

								const char *pPsMsg = ps.serialize();
								int mLength = ps.getSerializedLength();

								pMyPrinterMgr->send(pPsMsg, mLength);
							}
						}
						break;

		case PrSensors:	{	
							cout << "USB Printer -- PrSensors: " << endl;

							if (pMyPrinterMgr != NULL)
							{
								PrSensorsMsg *prSensorMsg = (PrSensorsMsg *) genMsg;

								// Create a PrSensorMsg and send it to the printer manager!
								PrinterSensors printerSensors(this, myPrinterType); // use default constructor

								printerSensors.setHeadup((PrinterHeadUpType) ntohs(prSensorMsg->headupReading));
								printerSensors.setLabelWidth((LabelWidth) ntohs(prSensorMsg->labelWidthReading));
								printerSensors.setRegulatorTemperature(ntohs(prSensorMsg->regulatorTemperatureReading));
								printerSensors.setHeadTemperature(ntohs(prSensorMsg->headTemperatureReading));
								printerSensors.setHeadVoltage(ntohs(prSensorMsg->headVoltageReading));
								printerSensors.setHeadCurrent(ntohs(prSensorMsg->headCurrentReading));
								printerSensors.setLabelHighAverage(ntohs(prSensorMsg->labelHighAverage));
								printerSensors.setLabelLowAverage(ntohs(prSensorMsg->labelLowAverage));
								printerSensors.setLabelThreshold(ntohs(prSensorMsg->labelThreshold));
								printerSensors.setLabel(ntohs(prSensorMsg->labelReading));
								printerSensors.setMediaHighAverage(ntohs(prSensorMsg->mediaHighAverage));
								printerSensors.setMediaLowAverage(ntohs(prSensorMsg->mediaLowAverage));
								printerSensors.setMediaThreshold(ntohs(prSensorMsg->mediaThreshold));
								printerSensors.setMedia(ntohs(prSensorMsg->mediaReading));

								const char *pWsMsg = printerSensors.serialize();
								int mLength = printerSensors.getSerializedLength();

								pMyPrinterMgr->send(pWsMsg, mLength);
							
							}
						} 
						break;
		case PrNomSize:	{	
							cout << "USB Printer -- PrNomSize: " << endl;

							if (pMyPrinterMgr != NULL)
							{
								PrNomSizeMsg *prNomSizeMsg = (PrNomSizeMsg *) genMsg;

								// Create a PrSensorMsg and send it to the printer manager!
								PrinterSize printerSize(this, myPrinterType,   
														ntohs(prNomSizeMsg->actualSize),
														ntohs(prNomSizeMsg->measuredSize));

								const char *pPsMsg = printerSize.serialize();
								int mLength = printerSize.getSerializedLength();

								pMyPrinterMgr->send(pPsMsg, mLength);
							}
						} 
						break;
		default:		cout << "USB Printer -- Some Other Type: " << (UINT16) genMsg->prEvent << endl;
						break;
	}
}

void PrinterCommManager::recvHeaderCallback(pVOID p)
{
	pUSB_IRP pIrp = (pUSB_IRP) p;
	PrinterCommManager *pLSMN = (PrinterCommManager *) pIrp->userPtr;

	if (pIrp->result == OK)
	{
		pLSMN->printerMessLen = 0;
		memcpy(pLSMN->printerMess, &pLSMN->bfrIntIN[0], pIrp->bfrList[0].actLen);
		pLSMN->printerMessLen += pIrp->bfrList [0].actLen;
	
//		pLSMN->recvDataIrp((UINT) pLSMN->bfrIntIN[0][8]);
// Testing Stuff
		pLSMN->recvDataIrp((UINT) pLSMN->bfrIntIN[0][16]);
// End of testing stuff
	}
	else
	{
		cout << "recvHeaderCallback Printer Irp Not Successfull!!" << endl;
	}
}

void PrinterCommManager::recvDataCallback(pVOID p)
{
	pUSB_IRP pIrp = (pUSB_IRP) p;
	PrinterCommManager *pPCM = (PrinterCommManager *)pIrp->userPtr;

	if (pIrp->result == OK)
	{
		int i = 0;
		while (pIrp->bfrList[i].actLen == EP2_MAX_PACKET_SIZE)
		{
			// do all the full buffers
			memcpy(&pPCM->printerMess[pPCM->printerMessLen], &pPCM->bfrIntIN[i], pIrp->bfrList[i].actLen);
			pPCM->printerMessLen += pIrp->bfrList[i].actLen;

			i++;
		} 

		// do the last buffer
		memcpy(&pPCM->printerMess[pPCM->printerMessLen], &pPCM->bfrIntIN[i], pIrp->bfrList[i].actLen);
		pPCM->printerMessLen += pIrp->bfrList[i].actLen;

		// We have achieved a complete Ultima Message
		pPCM->receivedPrinterMessage();

		// Restart the receiver
		pPCM->recvHeaderIrp();
	}
	else
	{
		cout << "PrinterCommManager -- recvDataCallback Irp Not Successfull!!: " << pIrp->result << endl;
	}
}

void PrinterCommManager::recvHeaderIrp()
{
	memset (&irpIntIN, 0, sizeof (irpIntIN));

	irpIntIN.irpLen = sizeof (irpIntIN);
	irpIntIN.userCallback = recvHeaderCallback;
	irpIntIN.userPtr = this;
//	irpIntIN.transferLen = 10;
// Testing Stuff
	irpIntIN.transferLen = 19;
// End of testing stuff
	irpIntIN.bfrCount = 1;
	irpIntIN.timeout = USB_TIMEOUT_NONE;
	irpIntIN.bfrList [0].pid = USB_PID_IN;
	irpIntIN.bfrList [0].pBfr = bfrIntIN[0];

//	irpIntIN.bfrList [0].bfrLen = 10;
// Testing Stuff
	irpIntIN.bfrList [0].bfrLen = 19;
// End of testing stuff

	if (pPPUM->transferData(intInPipeHandle, &irpIntIN))
	{
	    cout << "recvHeaderIrp Printer usbdTransfer() failed" << endl;
	}											
}

void PrinterCommManager::recvDataIrp(UINT dataLength)
{
	UINT16 numPackets = ((dataLength + (EP2_MAX_PACKET_SIZE)) / EP2_MAX_PACKET_SIZE); // allow for zero length packet
	int irpLength = sizeof(USB_IRP) + (sizeof (USB_BFR_LIST) * (numPackets - 1));

	memset (&irpIntIN, 0, irpLength);

	irpIntIN.irpLen = irpLength;
	irpIntIN.userCallback = recvDataCallback;
	irpIntIN.userPtr = this;
	irpIntIN.transferLen = dataLength;
	irpIntIN.bfrCount = numPackets;
	irpIntIN.timeout = USB_TIMEOUT_NONE;

	int i = 0;
	while (i < numPackets - 1)
	{
		irpIntIN.bfrList [i].pid = USB_PID_IN;
		irpIntIN.bfrList [i].pBfr = bfrIntIN[i];
		irpIntIN.bfrList [i].bfrLen = EP2_MAX_PACKET_SIZE;
		
		i++;
	}

	irpIntIN.bfrList [i].pid = USB_PID_IN;
	irpIntIN.bfrList [i].pBfr = bfrIntIN[i];
	irpIntIN.bfrList [i].bfrLen = dataLength - ((numPackets - 1) * EP2_MAX_PACKET_SIZE);

	if (pPPUM->transferData(intInPipeHandle, &irpIntIN) != OK)
	{
	    cout << "recvDataIrp Printer usbdTransfer() failed" << endl;
	}											
}

void PrinterCommManager::sendHeaderCallback(pVOID p)
{
	pUSB_IRP pIrp = (pUSB_IRP) p;
	PrinterCommManager *pLSMN = (PrinterCommManager *)pIrp->userPtr;

	if (pIrp->result == OK)
	{
		pLSMN->sendDataIrp();
	}
	else
	{
		cout << "sendHeaderCallback Printer Irp Not Successfull!!" << endl;
 }
}

void PrinterCommManager::sendDataCallback(pVOID p)
{
	pUSB_IRP pIrp = (pUSB_IRP) p;
	PrinterCommManager *pLSMN = (PrinterCommManager *)pIrp->userPtr;

	if (pIrp->result != OK)
	{
		cout << "sendDataCallback Printer Irp Not Successfull!!" << endl;
 }

	pLSMN->xmitting = false;
}

void PrinterCommManager::sendHeaderIrp()
{
	xmitting = true;

	evolHeader.Serialize((char *) bfrEovlHeaderOUT, true);

	#ifdef BFRHEADEROUT
		for (int j = 0; j < 19; j++)
		{
			cout << "bfrEovlHeaderOUT[" << j << "] = " << (UINT16)  bfrEovlHeaderOUT[j] << endl;
		}
	#endif

	memset (&irpIntOUT, 0, sizeof(USB_IRP));

	irpIntOUT.irpLen = sizeof(USB_IRP);
	irpIntOUT.userCallback = sendHeaderCallback;
	irpIntOUT.userPtr = this;

//	irpIntOUT.transferLen = 10;
// Testing Stuff
	irpIntOUT.transferLen = 19;
// End of testing stuff

	irpIntOUT.bfrCount = 1;
	irpIntOUT.timeout = USB_TIMEOUT_NONE;

	irpIntOUT.bfrList [0].pid = USB_PID_OUT;
	irpIntOUT.bfrList [0].pBfr = bfrEovlHeaderOUT;

//   	irpIntOUT.bfrList [0].bfrLen = 10;
// Testing Stuff
	irpIntOUT.bfrList [0].bfrLen = 19;
// End of testing stuff
	
	if (pPPUM->transferData(intOutPipeHandle, &irpIntOUT) != OK)
	{
	    cout << "sendIrp(Printer EvolHeader) usbdTransfer() failed" << endl;
	}

}

void PrinterCommManager::sendDataIrp()
{
	UINT16 dataLength = evolHeader.getMessageLength();
	UINT16 numPackets = ((dataLength + (EP2_MAX_PACKET_SIZE)) / EP2_MAX_PACKET_SIZE); // allow for zero length packet
	int irpLength = sizeof(USB_IRP) + (sizeof (USB_BFR_LIST) * (numPackets - 1));

	memset (&irpIntOUT, 0, irpLength);

	irpIntOUT.irpLen = irpLength;
	irpIntOUT.userCallback = sendDataCallback;
	irpIntOUT.userPtr = this;
	irpIntOUT.transferLen = dataLength;
	irpIntOUT.bfrCount = numPackets;
	irpIntOUT.timeout = USB_TIMEOUT_NONE;

	int i = 0;
	while (i < numPackets - 1)
	{
		#ifdef BFRDATAOUT
			for (int j = 0; j < EP2_MAX_PACKET_SIZE; j++)
			{
				cout << "bfrDataOUT[" << i << "][" << j << "] = " << (UINT16)  bfrDataOUT[i][j] << endl;
			}
		#endif

		irpIntOUT.bfrList [i].pid = USB_PID_OUT;
		irpIntOUT.bfrList [i].pBfr = bfrDataOUT[i];
		irpIntOUT.bfrList [i].bfrLen = EP2_MAX_PACKET_SIZE;
		
		i++;
	}

	#ifdef BFRDATAOUT
		for (int j = 0; j < dataLength - ((numPackets - 1) * EP2_MAX_PACKET_SIZE); j++)
		{
			cout << "bfrDataOUT[" << i << "][" << j << "] = " << (UINT16)  bfrDataOUT[i][j] << endl;
		}
	#endif

	irpIntOUT.bfrList [i].pid = USB_PID_OUT;
   	irpIntOUT.bfrList [i].pBfr = bfrDataOUT[i];
   	irpIntOUT.bfrList [i].bfrLen = dataLength - ((numPackets - 1) * EP2_MAX_PACKET_SIZE);
	

	if (pPPUM->transferData(intOutPipeHandle, &irpIntOUT) != OK)
	{
	    cout << "sendIrp(Printer Data) usbdTransfer() failed" << endl;
	}
}