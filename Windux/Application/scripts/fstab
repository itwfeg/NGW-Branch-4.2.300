# /etc/fstab: static file system information.
#
# Use 'blkid -o value -s UUID' to print the universally unique identifier
# for a device; this may be used with UUID= as a more robust way to name
# devices that works even if disks are added and removed. See fstab(5).
#
# <file system> <mount point>   <type>  <options>       <dump>  <pass>
# Modified with optimizations, FHA 10/20/2010
#
proc            /proc           proc    defaults        0       0

# / was on /dev/sdb1 during installation
# Modified FHA 10/20/2010
#UUID=d3da1cdc-b60e-406c-9f63-2552f5f9bdab /               ext4    errors=remount-ro 0       1
UUID=d3da1cdc-b60e-406c-9f63-2552f5f9bdab /               ext4    noatime,barrier=1,nobh,commit=100,nouser_xattr 0       1
# swap was on /dev/sdb5 during installation
# Removed FHA 10/20/2010
#UUID=a672d111-982e-405d-96de-822bd09eaf97 none            swap    sw              0       0

/dev/scd0       /media/cdrom0   udf,iso9660 user,noauto,exec,utf8 0       0
# Added FHA 10/20/2010
tmpfs /tmp	tmpfs defaults,noatime,mode=1777	0	0
none /var/tmp	aufs noatime,br:/tmp=rw:/var/tmp=ro	0	0
none /var/run	aufs noatime,br:/tmp=rw:/var/run=ro	0	0
none /var/log	aufs noatime,br:/tmp=rw:/var/log=ro	0	0
none /var/lock	aufs noatime,br:/tmp=rw:/var/lock=ro	0	0
none /var/cache aufs noatime,br:/tmp=rw:/var/cache=ro	0	0

