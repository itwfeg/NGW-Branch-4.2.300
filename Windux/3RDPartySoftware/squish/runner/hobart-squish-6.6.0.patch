diff -Naur squish-6.6.0-qt-src.ORIG/src/wrappers/qt/qtwrapper.cpp squish-6.6.0-qt-src/src/wrappers/qt/qtwrapper.cpp
--- squish-6.6.0-qt-src.ORIG/src/wrappers/qt/qtwrapper.cpp	2020-06-23 06:56:14.000000000 -0400
+++ squish-6.6.0-qt-src/src/wrappers/qt/qtwrapper.cpp	2020-07-20 10:24:09.598565883 -0400
@@ -5797,6 +5797,23 @@
     res |= e->type() == QEvent::MouseButtonRelease;
 #endif
 
+    // fix for specific hobart events (i.e. record/playback workaround)
+    if ( QEvent::KeyPress == e->type() )
+    {
+        QKeyEvent *keyEvent( static_cast<QKeyEvent*>( e ) );
+
+        // alt+arrow
+        // swipe
+        if ( Qt::AltModifier == keyEvent->modifiers() )
+            if (( Qt::Key_Down == keyEvent->key() ) ||
+                ( Qt::Key_Left == keyEvent->key() ) ||
+                ( Qt::Key_Right == keyEvent->key() ) ||
+                ( Qt::Key_Up == keyEvent->key() ))
+            {
+                res = true;
+            }
+    }
+
     return res;
 }
 
