// Dialog
//

IDD_WINAPPLAUNCHER_DIALOG DIALOGEX 0, 0, 447, 258
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE
EXSTYLE WS_EX_APPWINDOW
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "Web Server",IDC_TEXT_WEBSERVER,100,10,40,8
    CONTROL         1000,IDC_PICTURE,"Static",SS_BITMAP,20,70,401,94
    CONTROL         "",IDC_PROGRESS_WEBSERVER,"msctls_progress32",WS_BORDER,10,10,80,14
    CONTROL         "",IDC_PROGRESS_SCALESERVICE,"msctls_progress32",WS_BORDER,10,30,80,14
