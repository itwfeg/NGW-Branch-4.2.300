<logging>
	<appender name="applog" type="rollingFileAppender">
		<file>/var/log/walmart-applog.txt</file>
		<appendToFile>true</appendToFile>
		<maxSizeRollBackups>5</maxSizeRollBackups>
		<maximumFileSize>10</maximumFileSize>
		<layout type="patternLayout">
			<conversionPattern>%date{%m/%d/%Y %H:%M:%S.%L} %levelnum %class{%-15.15s} %method{%-15.15s} %message%newline</conversionPattern>
		</layout>
	</appender>
        <appender name="dialogmgr" type="rollingFileAppender">
                <file>/var/log/walmart-dialogmgr.txt</file>
                <appendToFile>true</appendToFile>
                <maxSizeRollBackups>5</maxSizeRollBackups>
                <maximumFileSize>10</maximumFileSize>
                <layout type="patternLayout">
                        <conversionPattern>%date{%m/%d/%Y %H:%M:%S.%L} %levelnum 0x%thread{%08x} %class{%-15.15s} %method{%-15.15s} %message%newline</conversionPattern>
                </layout>
        </appender>
	<appender name="commlog" type="rollingFileAppender">
		<file>/var/log/walmart-commlog.txt</file>
		<appendToFile>true</appendToFile>
		<maxSizeRollBackups>5</maxSizeRollBackups>
		<maximumFileSize>50</maximumFileSize>
		<layout type="patternLayout">
			<conversionPattern>%date{%m/%d/%Y %H:%M:%S.%L} [0x%thread{%08x},%level{%-5.5s}] %class{%-15.15s} %method{%-15.15s} %message%newline</conversionPattern>
		</layout>
	</appender>
	<appender name="console" type="consoleAppender">
		<layout type="patternLayout">
			<conversionPattern>%date{%H:%M:%S.%L} %level{%-5.5s} %class{%-15.15s} %method{%-15.15s} %message%newline</conversionPattern>
		</layout>
	</appender>
	<root>
		<level>WARN</level>
		<appender-ref>applog</appender-ref>
		<appender-ref>console</appender-ref>
	</root>
        <logger name="errorDialogManager.*">
                <level>INFO</level>
                <appender-ref>dialogmgr</appender-ref>
        </logger>
	<logger name="walmartapi.*">
		<level>INFO</level>
		<appender-ref>commlog</appender-ref>
	</logger>
	<logger name="networkAccess.*">
		<level>DEBUG</level>
		<appender-ref>commlog</appender-ref>
	</logger>
</logging>
