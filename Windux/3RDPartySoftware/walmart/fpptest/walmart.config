{
    "config": {
        "uuid": "${UUID}"
    },
    "eventController": {
        "events": {
            "applyScaleSettings": true,
            "captureMetrics": true,
            "changeConfiguration": true,
            "fetchPlu": true,
            "installFeature": true,
            "loadLabel": true,
            "upgradeFirmware": true
        },
        "timerInterval": "0 */1 * * *",
        "triggers": {
            "onInterval": true,
            "onReconnect": true,
            "onShutdown": true,
            "onStartup": true,
            "reconnectOffset": 0
        },
        "url": "http://127.0.0.1:8081/EventController"
    },
    "offlineDialogs": {
        "firstOfflineMessage": {
            "frequency": 60,
            "start": 120,
            "stop": 72
        },
        "firstPrintingMessage": {
            "start": 144,
            "stop": 120
        },
        "messageFade": 3,
        "secondOfflineMessage": {
            "frequency": 30,
            "start": 72,
            "stop": 24
        },
        "secondPrintingMessage": {
            "start": 24,
            "stop": 0
        }
    },
    "scaleConfig": {
        "scaleModelText": "${MODEL}",
        "serialNbr": "${SERIALNUM}",
        "scaleVendor": "HOBART",
        "scaleModel": "HTI"
    },
    "site": {
        "countryCode": "US",
        "businessUnit": "WALMART",
        "locationDept": "WM-BAKERY",
        "scaleNbr": 12,
        "storeNbr": 337
    }
}
