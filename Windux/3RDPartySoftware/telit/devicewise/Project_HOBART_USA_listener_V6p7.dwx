  <Action type="LUA_INLINE" id="87">
   <Properties>
    <Property name="lua_text" value="&#13;&#10;function main()&#13;&#10;&#13;&#10;  local  severity = DWInput[&quot;severity&quot;]&#13;&#10;  local  max_severity = 0&#13;&#10;  local  severity_1_count = DWInput[&quot;severity_1_count&quot;]&#13;&#10;  local  severity_2_count = DWInput[&quot;severity_2_count&quot;]&#13;&#10;  local  severity_3_count = DWInput[&quot;severity_3_count&quot;]&#13;&#10;  local  severity_4_count = DWInput[&quot;severity_4_count&quot;]&#13;&#10;&#13;&#10;  local severity_string = &quot;INVALID&quot;&#13;&#10;&#13;&#10;  if ( severity == 1)then&#13;&#10;   severity_string = &quot;1-Operational&quot;&#13;&#10;  elseif (severity == 2) then&#13;&#10;   severity_string = &quot;2-Recoverable&quot;&#13;&#10;  elseif (severity == 3) then&#13;&#10;   severity_string = &quot;3-Degraded&quot;&#13;&#10;  elseif (severity == 4) then  &#13;&#10;   severity_string = &quot;4-Critical&quot;&#13;&#10;  end&#13;&#10;&#13;&#10;  if ( severity == 1)then&#13;&#10;   severity_1_count = severity_1_count + 1&#13;&#10;  elseif (severity == 2) then&#13;&#10;   severity_2_count = severity_2_count + 1&#13;&#10;  elseif (severity == 3) then&#13;&#10;   severity_3_count = severity_3_count + 1&#13;&#10;  elseif (severity == 4) then  &#13;&#10;   severity_4_count = severity_4_count + 1&#13;&#10;  end  &#13;&#10;&#13;&#10;  if (severity_4_count ~= 0)then&#13;&#10;    max_severity  = 4 &#13;&#10;  elseif (severity_3_count ~= 0) then&#13;&#10;    max_severity  = 3&#13;&#10;      elseif (severity_2_count ~= 0) then&#13;&#10;    max_severity  = 2&#13;&#10;  elseif (severity_1_count ~= 0) then&#13;&#10;    max_severity  = 1&#13;&#10;  end&#13;&#10;&#13;&#10;  DWOutput[&quot;severity_1_count&quot;] = severity_1_count&#13;&#10;  &#13;&#10;  DWOutput[&quot;severity_2_count&quot;] = severity_2_count&#13;&#10;  &#13;&#10;  DWOutput[&quot;severity_3_count&quot;] = severity_3_count&#13;&#10;  &#13;&#10;  DWOutput[&quot;severity_4_count&quot;] = severity_4_count&#13;&#10;  &#13;&#10;  DWOutput[&quot;max_severity&quot;] = max_severity&#13;&#10;  &#13;&#10;  DWOutput[&quot;timedate&quot;] = os.date(&quot;%m/%d/%Y %H:%M:%S&quot;, DWInput[&quot;utcinput&quot;])    &#13;&#10;  &#13;&#10;  DWOutput[&quot;severity_string&quot;] = severity_string    &#13;&#10;&#13;&#10;end &#13;&#10;&#13;&#10;main()&#13;&#10;&#13;&#10;"/>
